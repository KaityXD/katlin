// compiler/main.ktl
// Katlin Native Self-Hosted Compiler Driver
// Fully written in Katlin. Compiles to native static ELF machine code.
// Zero Python dependency.

// -------------------------------------------------------------
// Character classification helpers
// -------------------------------------------------------------

fn is_space(int c) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn is_digit(int c) -> bool {
    return c >= 48 && c <= 57;
}

fn is_alpha(int c) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn is_alnum(int c) -> bool {
    return is_alpha(c) || is_digit(c);
}

fn trim_string(str s) -> str {
    len := str_len(s);
    mut start := 0;
    while start < len && is_space(str_char_at(s, start)) {
        start += 1;
    }
    mut end := len;
    while end > start && is_space(str_char_at(s, end - 1)) {
        end -= 1;
    }
    if start >= end { return ""; }
    return str_sub(s, start, end - start);
}

fn find_arg_comma(str s) -> int {
    len := str_len(s);
    mut in_str := false;
    mut depth := 0;
    for i in 0..len {
        c := str_char_at(s, i);
        if c == 34 { // '"'
            in_str = !in_str;
        } else if !in_str {
            if c == 40 || c == 91 || c == 123 { depth += 1; }
            else if c == 41 || c == 93 || c == 125 { depth -= 1; }
            else if c == 44 && depth == 0 { return i; } // ','
        }
    }
    return -1;
}

// Map a Katlin type name to its C spelling.
fn c_type_of(str t) -> str {
    if str_eq(t, "int") { return "ktl_int"; }
    if str_eq(t, "str") { return "ktl_str"; }
    if str_eq(t, "bool") { return "ktl_bool"; }
    if str_eq(t, "float") { return "ktl_float"; }
    if str_eq(t, "i64") { return "ktl_i64"; }
    if str_eq(t, "u64") { return "ktl_u64"; }
    if str_eq(t, "byte") { return "ktl_byte"; }
    if str_eq(t, "usize") { return "ktl_usize"; }
    if str_eq(t, "vec") { return "ktl_vec"; }
    if str_eq(t, "sb") { return "ktl_sb"; }
    if str_eq(t, "arena") { return "ktl_arena"; }
    return t;
}

fn format_c_params(str p) -> str {
    if str_len(p) == 0 { return "void"; }
    mut param_buf := sb_create(128);
    plen := str_len(p);
    mut pos := 0;
    while pos < plen {
        ch := str_char_at(p, pos);

        // Pointer types: `*mut T` -> `T*`, `*const T` -> `const T*`.
        if ch == 42 { // '*'
            mut q := pos + 1;
            while q < plen && is_space(str_char_at(p, q)) { q += 1; }
            mut is_const := false;
            mut matched := false;
            if q + 3 <= plen && str_eq(str_sub(p, q, 3), "mut") {
                matched = true;
                q += 3;
            } else if q + 5 <= plen && str_eq(str_sub(p, q, 5), "const") {
                matched = true;
                is_const = true;
                q += 5;
            }
            if matched {
                while q < plen && is_space(str_char_at(p, q)) { q += 1; }
                ts := q;
                while q < plen && is_alnum(str_char_at(p, q)) { q += 1; }
                if q > ts {
                    if is_const { sb_append(param_buf, "const "); }
                    sb_append(param_buf, c_type_of(str_sub(p, ts, q - ts)));
                    sb_append(param_buf, "*");
                    pos = q;
                    continue;
                }
            }
        }

        if is_alpha(ch) {
            start := pos;
            while pos < plen && is_alnum(str_char_at(p, pos)) { pos += 1; }
            w := str_sub(p, start, pos - start);
            sb_append(param_buf, c_type_of(w));
            continue;
        }
        if ch == 38 { // '&' -> '*'
            sb_append_char(param_buf, 42); // '*'
            pos += 1;
            continue;
        }
        // Drop parameter defaults: C has no such thing, and every call site
        // has already been given the full positional argument list.
        if ch == 61 && (pos + 1 >= plen || str_char_at(p, pos + 1) != 61) { // '='
            pos += 1;
            mut dd := 0;
            while pos < plen {
                dc := str_char_at(p, pos);
                if dc == 40 || dc == 91 { dd += 1; }
                else if dc == 41 || dc == 93 { dd -= 1; }
                else if dc == 44 && dd == 0 { break; } // ','
                pos += 1;
            }
            continue;
        }
        sb_append_char(param_buf, ch);
        pos += 1;
    }
    res := sb_build(param_buf);
    return res;
}

// Look up a compile-time type recorded for an inferred `name := value`.
fn type_of(str map, str name) -> str {
    needle := str_concat(str_concat("|", name), "=");
    idx := str_index_of(map, needle, 0);
    if idx < 0 {
        return "";
    }
    start := idx + str_len(needle);
    n := str_len(map);
    mut j := start;
    while j < n && str_char_at(map, j) != 124 { // '|'
        j += 1;
    }
    return str_sub(map, start, j - start);
}

// `println` argument lists are copied verbatim by the transpiler, so enum
// prefixes (`Color.Green`) have to be rewritten here too. Flat enum constants
// are used in the generated C, matching the statement-level handling.

// Dot-method sugar: `s.len()` -> `str_len(s)`, `v.push(x)` -> `vec_push(v, x)`.
// Old underscore names keep working. `x.type()` mirrors `x.type`.
fn is_dot_method(str m) -> bool {
    if str_eq(m, "len") { return true; }
    if str_eq(m, "push") { return true; }
    if str_eq(m, "get") { return true; }
    if str_eq(m, "set") { return true; }
    if str_eq(m, "append") { return true; }
    if str_eq(m, "append_char") { return true; }
    if str_eq(m, "build") { return true; }
    if str_eq(m, "free") { return true; }
    if str_eq(m, "trim") { return true; }
    if str_eq(m, "lower") { return true; }
    if str_eq(m, "upper") { return true; }
    if str_eq(m, "replace") { return true; }
    if str_eq(m, "repeat") { return true; }
    if str_eq(m, "split_at") { return true; }
    if str_eq(m, "count") { return true; }
    if str_eq(m, "char_at") { return true; }
    if str_eq(m, "sub") { return true; }
    if str_eq(m, "starts_with") { return true; }
    if str_eq(m, "ends_with") { return true; }
    if str_eq(m, "contains") { return true; }
    if str_eq(m, "index_of") { return true; }
    if str_eq(m, "eq") { return true; }
    if str_eq(m, "concat") { return true; }
    if str_eq(m, "join") { return true; }
    if str_eq(m, "has") { return true; }
    if str_eq(m, "alloc") { return true; }
    if str_eq(m, "reset") { return true; }
    if str_eq(m, "destroy") { return true; }
    if str_eq(m, "to_int") { return true; }
    if str_eq(m, "parse_int") { return true; }
    if str_eq(m, "type") { return true; }
    return false;
}

fn unique_method_callee(str m) -> str {
    if str_eq(m, "trim") { return "str_trim"; }
    if str_eq(m, "lower") { return "str_to_lower"; }
    if str_eq(m, "upper") { return "str_to_upper"; }
    if str_eq(m, "replace") { return "str_replace"; }
    if str_eq(m, "repeat") { return "str_repeat"; }
    if str_eq(m, "split_at") { return "str_split_at"; }
    if str_eq(m, "count") { return "str_count"; }
    if str_eq(m, "char_at") { return "str_char_at"; }
    if str_eq(m, "sub") { return "str_sub"; }
    if str_eq(m, "starts_with") { return "str_starts_with"; }
    if str_eq(m, "ends_with") { return "str_ends_with"; }
    if str_eq(m, "contains") { return "str_contains"; }
    if str_eq(m, "index_of") { return "str_index_of"; }
    if str_eq(m, "eq") { return "str_eq"; }
    if str_eq(m, "concat") { return "str_concat"; }
    if str_eq(m, "join") { return "vec_str_join"; }
    if str_eq(m, "has") { return "map_has"; }
    if str_eq(m, "append") { return "sb_append"; }
    if str_eq(m, "append_char") { return "sb_append_char"; }
    if str_eq(m, "build") { return "sb_build"; }
    if str_eq(m, "alloc") { return "arena_alloc"; }
    if str_eq(m, "reset") { return "arena_reset"; }
    if str_eq(m, "destroy") { return "arena_destroy"; }
    if str_eq(m, "to_int") { return "parse_int"; }
    if str_eq(m, "parse_int") { return "parse_int"; }
    return "";
}

fn method_callee_for(str recv_type, str method) -> str {
    if str_eq(recv_type, "str") {
        if str_eq(method, "len") { return "str_len"; }
        if str_eq(method, "eq") { return "str_eq"; }
        if str_eq(method, "concat") { return "str_concat"; }
        if str_eq(method, "trim") { return "str_trim"; }
        if str_eq(method, "lower") { return "str_to_lower"; }
        if str_eq(method, "upper") { return "str_to_upper"; }
        if str_eq(method, "replace") { return "str_replace"; }
        if str_eq(method, "repeat") { return "str_repeat"; }
        if str_eq(method, "split_at") { return "str_split_at"; }
        if str_eq(method, "count") { return "str_count"; }
        if str_eq(method, "char_at") { return "str_char_at"; }
        if str_eq(method, "sub") { return "str_sub"; }
        if str_eq(method, "starts_with") { return "str_starts_with"; }
        if str_eq(method, "ends_with") { return "str_ends_with"; }
        if str_eq(method, "contains") { return "str_contains"; }
        if str_eq(method, "index_of") { return "str_index_of"; }
        if str_eq(method, "parse_int") { return "parse_int"; }
        if str_eq(method, "to_int") { return "parse_int"; }
    }
    if str_eq(recv_type, "vec") {
        if str_eq(method, "push") { return "vec_push"; }
        if str_eq(method, "get") { return "vec_get"; }
        if str_eq(method, "set") { return "vec_set"; }
        if str_eq(method, "len") { return "vec_len"; }
        if str_eq(method, "free") { return "vec_free"; }
    }
    if str_eq(recv_type, "vec_str") {
        if str_eq(method, "push") { return "vec_str_push"; }
        if str_eq(method, "get") { return "vec_str_get"; }
        if str_eq(method, "len") { return "vec_str_len"; }
        if str_eq(method, "join") { return "vec_str_join"; }
        if str_eq(method, "free") { return "vec_str_free"; }
    }
    if str_eq(recv_type, "map") {
        if str_eq(method, "set") { return "map_set"; }
        if str_eq(method, "get") { return "map_get"; }
        if str_eq(method, "has") { return "map_has"; }
        if str_eq(method, "len") { return "map_len"; }
        if str_eq(method, "free") { return "map_free"; }
    }
    if str_eq(recv_type, "sb") {
        if str_eq(method, "append") { return "sb_append"; }
        if str_eq(method, "append_char") { return "sb_append_char"; }
        if str_eq(method, "build") { return "sb_build"; }
        if str_eq(method, "free") { return "sb_free"; }
        if str_eq(method, "len") { return "sb_len"; }
    }
    if str_eq(recv_type, "arena") {
        if str_eq(method, "alloc") { return "arena_alloc"; }
        if str_eq(method, "reset") { return "arena_reset"; }
        if str_eq(method, "destroy") { return "arena_destroy"; }
    }
    str u = unique_method_callee(method);
    return u;
}

fn infer_recv_type(str type_map, str recv) -> str {
    str t = str_trim(recv);
    int n = str_len(t);
    if n == 0 { return ""; }
    if str_char_at(t, 0) == 34 { return "str"; }
    int c0 = str_char_at(t, 0);
    if c0 >= 48 && c0 <= 57 { return "int"; }
    if str_eq(t, "true") { return "bool"; }
    if str_eq(t, "false") { return "bool"; }
    mut bool is_simple = true;
    mut int i = 0;
    while i < n {
        int c = str_char_at(t, i);
        if !(c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)) {
            is_simple = false;
            break;
        }
        i += 1;
    }
    if is_simple { return type_of(type_map, t); }
    if str_char_at(t, n - 1) == 41 {
        if str_contains(t, "str_trim") { return "str"; }
        if str_contains(t, "str_to_upper") { return "str"; }
        if str_contains(t, "str_to_lower") { return "str"; }
        if str_contains(t, "str_sub") { return "str"; }
        if str_contains(t, "str_concat") { return "str"; }
        if str_contains(t, "str_replace") { return "str"; }
        if str_contains(t, "str_repeat") { return "str"; }
        if str_contains(t, "str_split_at") { return "str"; }
        if str_contains(t, "sb_build") { return "str"; }
        if str_contains(t, "map_get") { return "str"; }
        if str_contains(t, "vec_str_get") { return "str"; }
        if str_contains(t, "vec_str_join") { return "str"; }
        if str_contains(t, "vec_str_create") { return "vec_str"; }
        if str_contains(t, "vec_create") { return "vec"; }
        if str_contains(t, "map_create") { return "map"; }
        if str_contains(t, "sb_create") { return "sb"; }
        if str_contains(t, "arena_create") { return "arena"; }
        return "";
    }
    return "";
}

fn find_fwd_paren(str s, int open_pos) -> int {
    int n = str_len(s);
    mut int depth = 0;
    mut int i = open_pos;
    mut bool in_str = false;
    while i < n {
        int c = str_char_at(s, i);
        if c == 34 { in_str = !in_str; }
        if !in_str {
            if c == 40 { depth += 1; }
            if c == 41 {
                depth -= 1;
                if depth == 0 { return i; }
            }
        }
        i += 1;
    }
    return -1;
}

fn find_bwd_paren(str s, int close_pos) -> int {
    mut int depth = 0;
    mut int i = close_pos;
    while i >= 0 {
        int c = str_char_at(s, i);
        if c == 41 { depth += 1; }
        if c == 40 {
            depth -= 1;
            if depth == 0 { return i; }
        }
        i -= 1;
    }
    return -1;
}

fn infer_init_kind(str init) -> str {
    str t = str_trim(init);
    int n = str_len(t);
    if n == 0 { return "int"; }
    if str_char_at(t, 0) == 34 { return "str"; }
    if str_starts_with(t, "vec_str_create") { return "vec_str"; }
    if str_starts_with(t, "vec_create") { return "vec"; }
    if str_starts_with(t, "map_create") { return "map"; }
    if str_starts_with(t, "sb_create") { return "sb"; }
    if str_starts_with(t, "arena_create") { return "arena"; }
    if str_starts_with(t, "str_trim") { return "str"; }
    if str_starts_with(t, "str_to_lower") { return "str"; }
    if str_starts_with(t, "str_to_upper") { return "str"; }
    if str_starts_with(t, "str_replace") { return "str"; }
    if str_starts_with(t, "str_repeat") { return "str"; }
    if str_starts_with(t, "str_split_at") { return "str"; }
    if str_starts_with(t, "str_sub") { return "str"; }
    if str_starts_with(t, "str_concat") { return "str"; }
    if str_starts_with(t, "str_from_char") { return "str"; }
    if str_starts_with(t, "str_int") { return "str"; }
    if str_starts_with(t, "sb_build") { return "str"; }
    if str_starts_with(t, "map_get") { return "str"; }
    if str_starts_with(t, "vec_str_get") { return "str"; }
    if str_starts_with(t, "vec_str_join") { return "str"; }
    if str_starts_with(t, "file_read") { return "str"; }
    if str_starts_with(t, "args_get") { return "str"; }
    if str_starts_with(t, "path_base") { return "str"; }
    if str_starts_with(t, "path_dir") { return "str"; }
    if str_starts_with(t, "dir_list") { return "str"; }
    if str_starts_with(t, "cmd_output") { return "str"; }
    if str_starts_with(t, "str_eq") { return "bool"; }
    if str_starts_with(t, "str_contains") { return "bool"; }
    if str_starts_with(t, "str_starts_with") { return "bool"; }
    if str_starts_with(t, "str_ends_with") { return "bool"; }
    if str_starts_with(t, "map_has") { return "bool"; }
    if str_starts_with(t, "file_exists") { return "bool"; }
    if str_starts_with(t, "vec_len") { return "int"; }
    if str_starts_with(t, "vec_str_len") { return "int"; }
    if str_starts_with(t, "map_len") { return "int"; }
    if str_starts_with(t, "str_len") { return "int"; }
    if str_starts_with(t, "str_count") { return "int"; }
    if str_starts_with(t, "parse_int") { return "int"; }
    int c0 = str_char_at(t, 0);
    if c0 >= 48 && c0 <= 57 {
        mut bool is_float = false;
        mut int i = 0;
        while i < n {
            if str_char_at(t, i) == 46 { is_float = true; }
            i += 1;
        }
        if is_float { return "float"; }
        return "int";
    }
    if str_eq(t, "true") { return "bool"; }
    if str_eq(t, "false") { return "bool"; }
    return "int";
}

fn collect_dot_types(str src) -> str {
    mut sb_m := sb_create(256);
    sb_append(sb_m, "|");
    int n = str_len(src);
    mut int i = 0;
    mut bool in_str = false;
    while i < n {
        int c = str_char_at(src, i);
        if c == 34 {
            in_str = !in_str;
            i += 1;
            continue;
        }
        if in_str {
            if c == 92 && i + 1 < n { i += 2; continue; }
            i += 1;
            continue;
        }
        if c == 47 && i + 1 < n && str_char_at(src, i + 1) == 47 {
            while i < n && str_char_at(src, i) != 10 { i += 1; }
            continue;
        }
        if is_alpha(c) {
            int ws = i;
            while i < n && is_alnum(str_char_at(src, i)) { i += 1; }
            str w = str_sub(src, ws, i - ws);
            mut int j = i;
            while j < n && is_space(str_char_at(src, j)) { j += 1; }
            if str_eq(w, "mut") {
                int ns = j;
                while j < n && is_alnum(str_char_at(src, j)) { j += 1; }
                if j > ns {
                    str w2 = str_sub(src, ns, j - ns);
                    mut int k = j;
                    while k < n && is_space(str_char_at(src, k)) { k += 1; }
                    if k + 1 < n && str_char_at(src, k) == 58 && str_char_at(src, k + 1) == 61 {
                        mut int v = k + 2;
                        while v < n && is_space(str_char_at(src, v)) { v += 1; }
                        mut int ve = v;
                        while ve < n && str_char_at(src, ve) != 59 && str_char_at(src, ve) != 10 { ve += 1; }
                        str init = str_sub(src, v, ve - v);
                        str kind = infer_init_kind(init);
                        sb_append(sb_m, w2);
                        sb_append_char(sb_m, 61);
                        sb_append(sb_m, kind);
                        sb_append_char(sb_m, 124);
                    } else {
                        if str_eq(w2, "int") || str_eq(w2, "str") || str_eq(w2, "bool") || str_eq(w2, "float") || str_eq(w2, "vec") || str_eq(w2, "vec_str") || str_eq(w2, "sb") || str_eq(w2, "arena") || str_eq(w2, "map") {
                            while k < n && is_space(str_char_at(src, k)) { k += 1; }
                            int ns2 = k;
                            while k < n && is_alnum(str_char_at(src, k)) { k += 1; }
                            if k > ns2 {
                                str vname = str_sub(src, ns2, k - ns2);
                                sb_append(sb_m, vname);
                                sb_append_char(sb_m, 61);
                                sb_append(sb_m, w2);
                                sb_append_char(sb_m, 124);
                            }
                        }
                    }
                }
                continue;
            }
            if j + 1 < n && str_char_at(src, j) == 58 && str_char_at(src, j + 1) == 61 {
                mut int v = j + 2;
                while v < n && is_space(str_char_at(src, v)) { v += 1; }
                mut int ve = v;
                while ve < n && str_char_at(src, ve) != 59 && str_char_at(src, ve) != 10 { ve += 1; }
                str init = str_sub(src, v, ve - v);
                str kind = infer_init_kind(init);
                sb_append(sb_m, w);
                sb_append_char(sb_m, 61);
                sb_append(sb_m, kind);
                sb_append_char(sb_m, 124);
                continue;
            }
            if str_eq(w, "int") || str_eq(w, "str") || str_eq(w, "bool") || str_eq(w, "float") || str_eq(w, "vec") || str_eq(w, "vec_str") || str_eq(w, "sb") || str_eq(w, "arena") || str_eq(w, "map") {
                if j < n && is_alpha(str_char_at(src, j)) {
                    int ns3 = j;
                    while j < n && is_alnum(str_char_at(src, j)) { j += 1; }
                    str vname = str_sub(src, ns3, j - ns3);
                    sb_append(sb_m, vname);
                    sb_append_char(sb_m, 61);
                    sb_append(sb_m, w);
                    sb_append_char(sb_m, 124);
                    i = j;
                    continue;
                }
            }
            continue;
        }
        i += 1;
    }
    return sb_build(sb_m);
}

fn rewrite_dot_once(str src, str type_map) -> str {
    mut sb_out := sb_create(str_len(src) + 64);
    int n = str_len(src);
    mut int i = 0;
    mut bool in_str = false;
    mut bool in_line = false;
    while i < n {
        int c = str_char_at(src, i);
        if in_line {
            sb_append_char(sb_out, c);
            if c == 10 { in_line = false; }
            i += 1;
            continue;
        }
        if in_str {
            sb_append_char(sb_out, c);
            if c == 92 && i + 1 < n {
                sb_append_char(sb_out, str_char_at(src, i + 1));
                i += 2;
                continue;
            }
            if c == 34 { in_str = false; }
            i += 1;
            continue;
        }
        if c == 34 {
            in_str = true;
            sb_append_char(sb_out, c);
            i += 1;
            continue;
        }
        if c == 47 && i + 1 < n && str_char_at(src, i + 1) == 47 {
            in_line = true;
            sb_append_char(sb_out, c);
            sb_append_char(sb_out, 47);
            i += 2;
            continue;
        }
        if c == 46 {
            mut int j = i + 1;
            while j < n && is_space(str_char_at(src, j)) { j += 1; }
            mut int k = j;
            while k < n && is_alnum(str_char_at(src, k)) { k += 1; }
            if k > j {
                str mname = str_sub(src, j, k - j);
                if is_dot_method(mname) {
                    mut int l = k;
                    while l < n && is_space(str_char_at(src, l)) { l += 1; }
                    if l < n && str_char_at(src, l) == 40 {
                        mut int rs = i - 1;
                        while rs >= 0 && is_space(str_char_at(src, rs)) { rs -= 1; }
                        if rs >= 0 {
                            mut int recv_start = -1;
                            int rc = str_char_at(src, rs);
                            if is_alnum(rc) {
                                mut int s = rs;
                                while s >= 0 && is_alnum(str_char_at(src, s)) { s -= 1; }
                                recv_start = s + 1;
                            } else if rc == 34 {
                                mut int s = rs - 1;
                                mut int found = -1;
                                while s >= 0 {
                                    if str_char_at(src, s) == 34 {
                                        if s == 0 || str_char_at(src, s - 1) != 92 {
                                            found = s;
                                            break;
                                        }
                                    }
                                    s -= 1;
                                }
                                if found >= 0 { recv_start = found; }
                            } else if rc == 41 {
                                int open = find_bwd_paren(src, rs);
                                if open >= 0 {
                                    mut int s = open - 1;
                                    while s >= 0 && is_space(str_char_at(src, s)) { s -= 1; }
                                    while s >= 0 && is_alnum(str_char_at(src, s)) { s -= 1; }
                                    recv_start = s + 1;
                                }
                            }
                            if recv_start >= 0 {
                                str recv = str_sub(src, recv_start, rs - recv_start + 1);
                                if str_eq(mname, "type") {
                                    int close = find_fwd_paren(src, l);
                                    if close >= 0 {
                                        str args = str_sub(src, l + 1, close - (l + 1));
                                        str args_t = str_trim(args);
                                        if str_len(args_t) == 0 {
                                            mut str rtype = infer_recv_type(type_map, recv);
                                            if str_len(rtype) == 0 { rtype = "int"; }
                                            str cur = sb_build(sb_out);
                                            int cur_len = str_len(cur);
                                            int drop = i - recv_start;
                                            str trunc = str_sub(cur, 0, cur_len - drop);
                                            mut sb_new := sb_create(str_len(src) + 64);
                                            sb_append(sb_new, trunc);
                                            sb_append_char(sb_new, 34);
                                            sb_append(sb_new, rtype);
                                            sb_append_char(sb_new, 34);
                                            str tail = str_sub(src, close + 1, n - (close + 1));
                                            sb_append(sb_new, tail);
                                            return sb_build(sb_new);
                                        }
                                    }
                                } else {
                                    str rtype = infer_recv_type(type_map, recv);
                                    str callee = method_callee_for(rtype, mname);
                                    if str_len(callee) > 0 {
                                        int close = find_fwd_paren(src, l);
                                        if close >= 0 {
                                            str args = str_sub(src, l + 1, close - (l + 1));
                                            str args_t = str_trim(args);
                                            str cur = sb_build(sb_out);
                                            int cur_len = str_len(cur);
                                            int drop = i - recv_start;
                                            str trunc = str_sub(cur, 0, cur_len - drop);
                                            mut sb_new := sb_create(str_len(src) + 64);
                                            sb_append(sb_new, trunc);
                                            sb_append(sb_new, callee);
                                            sb_append_char(sb_new, 40);
                                            sb_append(sb_new, recv);
                                            if str_len(args_t) > 0 {
                                                sb_append_char(sb_new, 44);
                                                sb_append_char(sb_new, 32);
                                                sb_append(sb_new, args);
                                            }
                                            sb_append_char(sb_new, 41);
                                            str tail = str_sub(src, close + 1, n - (close + 1));
                                            sb_append(sb_new, tail);
                                            return sb_build(sb_new);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        sb_append_char(sb_out, c);
        i += 1;
    }
    return sb_build(sb_out);
}

fn rewrite_dot_all(str src, str type_map) -> str {
    mut str cur = src;
    mut int iter = 0;
    while iter < 100 {
        str nxt = rewrite_dot_once(cur, type_map);
        if str_eq(nxt, cur) { break; }
        cur = nxt;
        iter += 1;
    }
    return cur;
}

fn strip_enum_prefix(str expr, str enum_names) -> str {
    mut out := sb_create(256);
    n := str_len(expr);
    mut i := 0;
    while i < n {
        ch := str_char_at(expr, i);
        if is_alpha(ch) {
            ws := i;
            while i < n && is_alnum(str_char_at(expr, i)) { i += 1; }
            w := str_sub(expr, ws, i - ws);
            if str_contains(enum_names, str_concat("|", str_concat(w, "|"))) {
                mut j := i;
                while j < n && is_space(str_char_at(expr, j)) { j += 1; }
                if j < n && str_char_at(expr, j) == 46 { // '.'
                    i = j + 1;
                    continue;
                }
            }
            sb_append(out, w);
        } else {
            sb_append_char(out, ch);
            i += 1;
        }
    }
    return sb_build(out);
}

// Inside a `println` argument list the transpiler copies text verbatim, so
// compile-time `.type` resolution has to happen here as well.
fn resolve_type_access(str expr, str type_map) -> str {
    str trimmed = trim_string(expr);
    int n = str_len(trimmed);
    if n > 7 && str_ends_with(trimmed, ".type()") {
        str base = str_sub(trimmed, 0, n - 7);
        mut str t = type_of(type_map, base);
        if str_len(t) == 0 {
            t = infer_recv_type(type_map, base);
        }
        if str_len(t) > 0 {
            return str_concat("\"", str_concat(t, "\""));
        }
    }
    if n > 5 && str_ends_with(trimmed, ".type") {
        str base = str_sub(trimmed, 0, n - 5);
        mut str t = type_of(type_map, base);
        if str_len(t) == 0 {
            t = infer_recv_type(type_map, base);
        }
        if str_len(t) > 0 {
            return str_concat("\"", str_concat(t, "\""));
        }
    }
    return expr;
}

// `println` argument lists are copied verbatim, so member access through a
// `&` parameter (`from.id` -> `from->id`) and through a reference field
// (`a.balance` -> `(*a.balance)`) has to be rewritten here as well.
fn rewrite_member_access_in(str expr, str ref_fields, str ref_params) -> str {
    if str_len(ref_fields) <= 1 && str_len(ref_params) <= 1 {
        return expr;
    }
    mut out := sb_create(str_len(expr) + 32);
    n := str_len(expr);
    mut i := 0;
    while i < n {
        c := str_char_at(expr, i);
        if is_alpha(c) {
            ws := i;
            while i < n && is_alnum(str_char_at(expr, i)) { i += 1; }
            w := str_sub(expr, ws, i - ws);
            is_refparam := str_contains(ref_params, str_concat("|", str_concat(w, "|")));
            mut j := i;
            while j < n && is_space(str_char_at(expr, j)) { j += 1; }
            if j < n && str_char_at(expr, j) == 46 { // '.'
                fs := j + 1;
                mut fe := fs;
                while fe < n && is_alnum(str_char_at(expr, fe)) { fe += 1; }
                fld := str_sub(expr, fs, fe - fs);
                is_reffield := str_len(fld) > 0 && str_contains(ref_fields, str_concat("|", str_concat(fld, "|")));
                if is_reffield {
                    sb_append(out, "(*");
                    sb_append(out, w);
                    if is_refparam {
                        sb_append(out, "->");
                    } else {
                        sb_append(out, ".");
                    }
                    sb_append(out, fld);
                    sb_append(out, ")");
                    i = fe;
                    continue;
                }
                if is_refparam {
                    sb_append(out, w);
                    sb_append(out, "->");
                    sb_append(out, fld);
                    i = fe;
                    continue;
                }
            }
            // A `&` parameter is a pointer, so using its value needs a
            // dereference. Missing this in a loop condition compared the
            // pointer address and produced an infinite loop.
            if is_refparam {
                sb_append(out, "(*");
                sb_append(out, w);
                sb_append(out, ")");
                continue;
            }
            sb_append(out, w);
            continue;
        }
        sb_append_char(out, c);
        i += 1;
    }
    return sb_build(out);
}

// Apply every expression-level rewrite the transpiler knows about to a piece
// of source text that would otherwise be copied verbatim (a `println`
// argument list, or the condition of an `if`/`while`).
fn rewrite_expr_text(str e, str type_map, str enum_names, str ref_fields, str ref_params) -> str {
    str step0 = rewrite_dot_all(e, type_map);
    str step1 = resolve_type_access(step0, type_map);
    str step2 = strip_enum_prefix(step1, enum_names);
    return rewrite_member_access_in(step2, ref_fields, ref_params);
}

fn emit_print(sb &out_sb, str args_str, bool is_nl, str type_map, str enum_names, str ref_fields, str ref_params) {
    idx_comma := find_arg_comma(args_str);
    if idx_comma == -1 {
        // Single argument, e.g. println("Counting from 0 to 1,000,000,000...")
        trimmed := trim_string(args_str);
        if str_starts_with(trimmed, "\"") && str_ends_with(trimmed, "\"") {
            tlen := str_len(trimmed);
            inner := str_sub(trimmed, 1, tlen - 2);
            sb_append(out_sb, "printf(\"");
            sb_append(out_sb, inner);
            if is_nl { sb_append(out_sb, "\\n"); }
            sb_append(out_sb, "\")");
        } else {
            sb_append(out_sb, "ktl_print_any(");
            sb_append(out_sb, rewrite_expr_text(trimmed, type_map, enum_names, ref_fields, ref_params));
            sb_append(out_sb, ")");
            if is_nl { sb_append(out_sb, "; printf(\"\\n\")"); }
        }
        return;
    }

    // Multiple arguments: first is format string, rest are values
    fmt_raw := trim_string(str_sub(args_str, 0, idx_comma));
    mut str rest_args = trim_string(str_sub(args_str, idx_comma + 1, str_len(args_str) - (idx_comma + 1)));

    mut str fmt_text = fmt_raw;
    if str_starts_with(fmt_raw, "\"") && str_ends_with(fmt_raw, "\"") {
        fmt_text = str_sub(fmt_raw, 1, str_len(fmt_raw) - 2);
    }

    flen := str_len(fmt_text);
    mut last := 0;
    for i in 0..flen {
        if str_char_at(fmt_text, i) == 37 { // '%'
            piece := str_sub(fmt_text, last, i - last);
            if str_len(piece) > 0 {
                sb_append(out_sb, "printf(\"");
                sb_append(out_sb, piece);
                sb_append(out_sb, "\"); ");
            }
            next_comma := find_arg_comma(rest_args);
            mut str curr_arg = "";
            if next_comma == -1 {
                curr_arg = trim_string(rest_args);
                rest_args = "";
            } else {
                curr_arg = trim_string(str_sub(rest_args, 0, next_comma));
                rest_args = trim_string(str_sub(rest_args, next_comma + 1, str_len(rest_args) - (next_comma + 1)));
            }
            if str_len(curr_arg) > 0 {
                sb_append(out_sb, "ktl_print_any(");
                sb_append(out_sb, rewrite_expr_text(curr_arg, type_map, enum_names, ref_fields, ref_params));
                sb_append(out_sb, "); ");
            }
            last = i + 1;
        }
    }
    if last < flen {
        trailing := str_sub(fmt_text, last, flen - last);
        sb_append(out_sb, "printf(\"");
        sb_append(out_sb, trailing);
        sb_append(out_sb, "\"); ");
    }
    if is_nl {
        sb_append(out_sb, "printf(\"\\n\")");
    }
}

// -------------------------------------------------------------
// Project Scaffolding (katlin init)
// -------------------------------------------------------------

fn cmd_init(str name) -> int {
    if str_len(name) == 0 {
        println("\x1b[1;31merror\x1b[0m: project name required. Example: katlin init my_project");
        return 1;
    }

    if file_exists(name) {
        println("\x1b[1;31merror\x1b[0m: directory '%' already exists", name);
        return 1;
    }

    system(str_concat("mkdir -p ", str_concat(name, "/src")));
    system(str_concat("mkdir -p ", str_concat(name, "/tests")));

    toml_path := str_concat(name, "/katlin.toml");
    toml_content := str_concat("[project]\nname = \"", str_concat(name, "\"\nversion = \"0.1.0\"\nauthor = \"Developer\"\n\n[build]\nopt_level = 3\n"));
    file_write(toml_path, toml_content);

    main_path := str_concat(name, "/src/main.ktl");
    main_code := "// src/main.ktl\nfn main {\n    println(\"Hello from %!\", \"Katlin\");\n    for i in 0..10 {\n        println(\"Counting: %\", i);\n    }\n}\n";
    file_write(main_path, main_code);

    test_path := str_concat(name, "/tests/main_test.ktl");
    test_code := "// tests/main_test.ktl\nfn add(int a, int b) -> int {\n    return a + b;\n}\n\ntest \"verify addition\" {\n    assert(add(2, 3) == 5, \"2 + 3 must be 5\");\n}\n";
    file_write(test_path, test_code);

    ignore_path := str_concat(name, "/.gitignore");
    file_write(ignore_path, ".build/\nbin/\n*.o\n*.a\n");

    println("\x1b[1;32m✓\x1b[0m Initialized new Katlin project in '%'", name);
    println("  Run 'katlin run %/src/main.ktl' to get started!", name);
    return 0;
}

// -------------------------------------------------------------
// Version and Help
// -------------------------------------------------------------

fn print_version {
    println("\x1b[1;34mKatlin\x1b[0m Native Compiler v0.1.0 (Self-Hosted in Katlin)");
    println("Backend: Clang C99 / LLVM Native Vectorizer");
    println("Platform: Linux x86_64 (Zero-GC / Bare-Metal)");
}

fn print_help {
    print_version();
    println("\n\x1b[1;37mUsage:\x1b[0m katlin <command> [options]\n");
    println("\x1b[1;33mCommands:\x1b[0m");
    println("  run <file.ktl> [args...]       Compile and execute Katlin source immediately");
    println("  build <file.ktl> [options]     Compile Katlin source to a native static binary");
    println("  check <file.ktl>               Type-check only; no binary produced");
    println("  test [path]                    Find and run all test blocks across the project");
    println("  fmt [path]                     Auto-format .ktl source files");
    println("  init <project_name>            Scaffold a new Katlin application project");
    println("  version, --version, -v         Display Katlin compiler version info");
    println("\n\x1b[1;33mBuild Options:\x1b[0m");
    println("  -o <file>                      Specify output binary path");
    println("  --debug                        Compile with -O0 -g (debug symbols)");
    println("  --release                      Compile with full -O3 -flto optimizations (default)");
    println("  --target <triple>              Cross-compile (e.g. aarch64-linux-gnu)");
    println("  --sysroot <dir>                Sysroot for the cross target (libc headers)");
}

// -------------------------------------------------------------
// Transpiler: Katlin -> C99
// -------------------------------------------------------------

// Collect `&name` parameters from a raw parameter list into "|a|b|" form.
// C takes these by pointer, so every use inside the body needs a `*` prefix;
// without that, `a = a + 1` compiled to pointer arithmetic on the pointer
// itself and silently left the caller's variable untouched.
fn extract_ref_params(str params) -> str {
    mut str out = "|";
    n := str_len(params);
    mut i := 0;
    while i < n {
        if str_char_at(params, i) == 38 { // '&'
            mut j := i + 1;
            while j < n && is_space(str_char_at(params, j)) { j += 1; }
            ns := j;
            while j < n && is_alnum(str_char_at(params, j)) { j += 1; }
            if j > ns {
                out = str_concat(out, str_concat(str_sub(params, ns, j - ns), "|"));
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return out;
}

fn transpile_source(str src, bool test_mode) -> str {
    // Dot-method sugar pre-pass: `s.len()` -> `str_len(s)` etc, `x.type()` -> `"type"`.
    // Old underscore names keep working. Skips strings/comments; leaves struct
    // fields (`p.x`), enums (`Color.Green`) and inner chains (`.start()`) alone.
    str pre_types = collect_dot_types(src);
    src = rewrite_dot_all(src, pre_types);

    mut out_buf := sb_create(65536);
    sb_append(out_buf, "// Generated by Katlin Native Compiler (Self-Hosted)\n");
    sb_append(out_buf, "#include \"katlin_runtime.h\"\n\n");

    len := str_len(src);
    mut pos := 0;
    mut in_main := false;
    mut main_depth := 0;
    // Test-runner state. In test mode `test "name" { ... }` blocks become
    // void functions and the original `fn main` is renamed so the generated
    // runner can own `main`.
    mut test_n := 0;
    mut main_void := false;
    mut runner_buf := sb_create(4096);

    // Aggregate-type state.
    //   Katlin `struct Point { ... }`  -> C `typedef struct Point { ... } Point;`
    //   Katlin `Point{ x = 1 }`        -> C `(Point){ .x = 1 }`
    //   Katlin `Color.Green`           -> C `Green`   (flat enum constants)
    //   Katlin `match c { case .Red: }`-> C `{ __auto_type _m = c; if (_m == Red) ... }`
    // Known type names are tracked so `.` can be disambiguated between a struct
    // field access (keep the dot) and an enum variant access (drop the prefix).
    mut in_type_def := false;
    mut def_depth := 0;
    mut str def_name = "";
    mut in_init := false;
    mut init_depth := 0;
    // Set when a `field:` designator has emitted its dot and is waiting for
    // the colon to turn into `=`.
    mut init_colon_pending := false;
    // Reference fields declared by any struct, as "|balance|". Initialising one
    // takes the address of the value, the same way a `&` parameter does.
    mut str ref_fields = "|";
    mut init_amp_field := false;
    mut init_amp_next := false;
    mut in_match := false;
    mut match_depth := 0;
    mut match_first := false;
    mut match_n := 0;
    mut str match_var = "";
    mut str struct_names = "|";
    mut str enum_names = "|";

    // Reference parameters of the function currently being emitted. Names are
    // matched with `*` on every use; reset when the function body closes.
    mut str ref_params = "|";
    mut fn_depth := 0;

    // Compile-time types of `:=` variables, as "|name=int|ratio=float|".
    // Lets `value.type` resolve without any runtime type information.
    // Seeded from the pre-pass so explicit types and call results resolve too.
    mut str type_map = pre_types;

    // Whether the function currently being emitted returns nothing. A postfix
    // guard becomes `return;` in a void function and `return 0;` otherwise,
    // which keeps the generated C valid in both cases.
    mut cur_void := true;

    // Set by the `mut` handler when the declaration that follows is
    // `mut name := value`, so the `:=` handler knows to omit `const`.
    mut pending_inferred_mut := false;

    while pos < len {
        c := str_char_at(src, pos);

        // The value of a reference field is a value, so take its address:
        // `{ balance: b }` becomes `{ .balance = &b }`. Checked here, at the
        // top, so it also applies when the value starts with an identifier
        // (which the identifier branch below consumes).
        if init_amp_next && c != 32 && c != 9 && c != 10 && c != 13 {
            if c != 38 && c != 42 { // not already '&' or '*'
                sb_append_char(out_buf, 38); // '&'
            }
            init_amp_next = false;
        }

        // Skip comments
        if c == 47 && pos + 1 < len { // '/'
            c2 := str_char_at(src, pos + 1);
            if c2 == 47 { // '//'
                while pos < len && str_char_at(src, pos) != 10 {
                    sb_append_char(out_buf, str_char_at(src, pos));
                    pos += 1;
                }
                sb_append_char(out_buf, 10);
                pos += 1;
                continue;
            }
            if c2 == 42 { // '/*'
                sb_append(out_buf, "/*");
                pos += 2;
                while pos + 1 < len {
                    if str_char_at(src, pos) == 42 && str_char_at(src, pos + 1) == 47 {
                        pos += 2;
                        sb_append(out_buf, "*/");
                        break;
                    }
                    sb_append_char(out_buf, str_char_at(src, pos));
                    pos += 1;
                }
                continue;
            }
        }

        // Pragmas
        if c == 35 { // '#'
            while pos < len && str_char_at(src, pos) != 10 {
                pos += 1;
            }
            pos += 1;
            continue;
        }

        // String literals
        if c == 34 { // '"'
            sb_append_char(out_buf, 34);
            pos += 1;
            while pos < len {
                sc := str_char_at(src, pos);
                if sc == 92 && pos + 1 < len { // '\'
                    sb_append_char(out_buf, 92);
                    sb_append_char(out_buf, str_char_at(src, pos + 1));
                    pos += 2;
                    continue;
                }
                if sc == 34 { // '"'
                    sb_append_char(out_buf, 34);
                    pos += 1;
                    break;
                }
                sb_append_char(out_buf, sc);
                pos += 1;
            }
            continue;
        }

        // Identifiers and Keywords
        if is_alpha(c) {
            mut start := pos;
            while pos < len && is_alnum(str_char_at(src, pos)) {
                pos += 1;
            }
            wlen := pos - start;
            word := str_sub(src, start, wlen);

            if str_eq(word, "import") {
                while pos < len && str_char_at(src, pos) != 10 && str_char_at(src, pos) != 59 {
                    pos += 1;
                }
                if pos < len && str_char_at(src, pos) == 59 { pos += 1; }
                continue;
            }

            if str_eq(word, "fn") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                name_start := pos;
                while pos < len && is_alnum(str_char_at(src, pos)) { pos += 1; }
                fn_name := str_sub(src, name_start, pos - name_start);

                if str_eq(fn_name, "main") {
                    in_main = true;
                    main_depth = 1;
                    ref_params = "|";
                    cur_void = false; // main returns an int status
                    while pos < len && str_char_at(src, pos) != 123 { pos += 1; }
                    if pos < len && str_char_at(src, pos) == 123 { pos += 1; }
                    if test_mode {
                        main_void = true;
                        sb_append(out_buf, "static void ktl_user_main(int argc, char** argv) {\n");
                    } else {
                        sb_append(out_buf, "int main(int argc, char** argv) {\n");
                    }
                    sb_append(out_buf, "    ktl_init_args(argc, argv);\n");
                    continue;
                }

                while pos < len && str_char_at(src, pos) != 123 && str_char_at(src, pos) != 40 {
                    pos += 1;
                }
                mut str params_str = "";
                if pos < len && str_char_at(src, pos) == 40 { // '('
                    p_start := pos + 1;
                    while pos < len && str_char_at(src, pos) != 41 { pos += 1; }
                    params_str = str_sub(src, p_start, pos - p_start);
                    pos += 1;
                }

                mut str ret_type = "void";
                while pos < len && str_char_at(src, pos) != 123 {
                    if str_char_at(src, pos) == 45 && pos + 1 < len && str_char_at(src, pos + 1) == 62 { // '->'
                        pos += 2;
                        while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                        r_start := pos;
                        while pos < len && is_alnum(str_char_at(src, pos)) { pos += 1; }
                        raw_ret := str_sub(src, r_start, pos - r_start);
                        if str_eq(raw_ret, "int") { ret_type = "ktl_int"; }
                        else if str_eq(raw_ret, "str") { ret_type = "ktl_str"; }
                        else if str_eq(raw_ret, "bool") { ret_type = "ktl_bool"; }
                        else if str_eq(raw_ret, "float") { ret_type = "ktl_float"; }
                        else if str_eq(raw_ret, "i64") { ret_type = "ktl_i64"; }
                        else { ret_type = raw_ret; }
                        break;
                    }
                    pos += 1;
                }
                while pos < len && str_char_at(src, pos) != 123 { pos += 1; }
                if pos < len && str_char_at(src, pos) == 123 { pos += 1; }
                ref_params = extract_ref_params(params_str);
                fn_depth = 1;
                cur_void = str_eq(ret_type, "void");

                sb_append(out_buf, "static ");
                sb_append(out_buf, ret_type);
                sb_append(out_buf, " ");
                sb_append(out_buf, fn_name);
                sb_append(out_buf, "(");
                if str_len(params_str) == 0 {
                    sb_append(out_buf, "void");
                } else {
                    sb_append(out_buf, format_c_params(params_str));
                }
                sb_append(out_buf, ") {\n");
                continue;
            }

            if str_eq(word, "while") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                c_start := pos;
                while pos < len && str_char_at(src, pos) != 123 { pos += 1; }
                mut cond := trim_string(str_sub(src, c_start, pos - c_start));
                cond = rewrite_expr_text(cond, type_map, enum_names, ref_fields, ref_params);
                if pos < len && str_char_at(src, pos) == 123 {
                    if in_main { main_depth += 1; }
                    if fn_depth > 0 { fn_depth += 1; }
                    pos += 1;
                }

                sb_append(out_buf, "while (");
                sb_append(out_buf, cond);
                sb_append(out_buf, ") {\n");
                continue;
            }

            if str_eq(word, "if") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                c_start := pos;
                while pos < len && str_char_at(src, pos) != 123 { pos += 1; }
                mut cond := trim_string(str_sub(src, c_start, pos - c_start));
                cond = rewrite_expr_text(cond, type_map, enum_names, ref_fields, ref_params);
                if pos < len && str_char_at(src, pos) == 123 {
                    if in_main { main_depth += 1; }
                    if fn_depth > 0 { fn_depth += 1; }
                    pos += 1;
                }

                sb_append(out_buf, "if (");
                sb_append(out_buf, cond);
                sb_append(out_buf, ") {\n");
                continue;
            }

            if str_eq(word, "for") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                v_start := pos;
                while pos < len && is_alnum(str_char_at(src, pos)) { pos += 1; }
                var_name := str_sub(src, v_start, pos - v_start);

                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                if pos + 2 < len && str_char_at(src, pos) == 105 && str_char_at(src, pos + 1) == 110 {
                    pos += 2;
                }
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                
                r_start := pos;
                while pos + 1 < len && !(str_char_at(src, pos) == 46 && str_char_at(src, pos + 1) == 46) {
                    pos += 1;
                }
                range_start := trim_string(str_sub(src, r_start, pos - r_start));
                pos += 2;

                e_start := pos;
                while pos < len && str_char_at(src, pos) != 123 {
                    if pos + 4 < len && str_char_at(src, pos) == 115 && str_char_at(src, pos + 1) == 116 && str_char_at(src, pos + 2) == 101 && str_char_at(src, pos + 3) == 112 {
                        break;
                    }
                    pos += 1;
                }
                range_end := trim_string(str_sub(src, e_start, pos - e_start));

                mut str step_val = "";
                if pos + 4 < len && str_char_at(src, pos) == 115 && str_char_at(src, pos + 1) == 116 && str_char_at(src, pos + 2) == 101 && str_char_at(src, pos + 3) == 112 {
                    pos += 4;
                    while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                    s_start := pos;
                    while pos < len && str_char_at(src, pos) != 123 { pos += 1; }
                    step_val = trim_string(str_sub(src, s_start, pos - s_start));
                }

                if pos < len && str_char_at(src, pos) == 123 {
                    if in_main { main_depth += 1; }
                    if fn_depth > 0 { fn_depth += 1; }
                    pos += 1;
                }

                sb_append(out_buf, "for (ktl_int ");
                sb_append(out_buf, var_name);
                sb_append(out_buf, " = ");
                sb_append(out_buf, range_start);
                sb_append(out_buf, "; ");
                sb_append(out_buf, var_name);
                sb_append(out_buf, " < ");
                sb_append(out_buf, range_end);
                sb_append(out_buf, "; ");
                sb_append(out_buf, var_name);
                if str_len(step_val) > 0 {
                    sb_append(out_buf, " += ");
                    sb_append(out_buf, step_val);
                } else {
                    sb_append(out_buf, "++");
                }
                sb_append(out_buf, ") {\n");
                continue;
            }

            mut is_test_block := false;
            if str_eq(word, "test") && !in_main && fn_depth == 0 {
                mut t_peek := pos;
                while t_peek < len && is_space(str_char_at(src, t_peek)) { t_peek += 1; }
                if t_peek < len && str_char_at(src, t_peek) == 34 { // '"'
                    is_test_block = true;
                }
            }

            if is_test_block {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                mut str tname = "";
                if pos < len && str_char_at(src, pos) == 34 { // '"'
                    pos += 1;
                    ns := pos;
                    while pos < len && str_char_at(src, pos) != 34 { pos += 1; }
                    tname = str_sub(src, ns, pos - ns);
                    if pos < len { pos += 1; }
                }
                while pos < len && str_char_at(src, pos) != 123 { pos += 1; }

                if test_mode {
                    if pos < len && str_char_at(src, pos) == 123 { pos += 1; }
                    fname := str_concat("ktl_test_", str_int(test_n));
                    sb_append(out_buf, "\nstatic void ");
                    sb_append(out_buf, fname);
                    sb_append(out_buf, "(void) {\n    ktl_test_current = \"");
                    sb_append(out_buf, tname);
                    sb_append(out_buf, "\";\n");

                    sb_append(runner_buf, "    before = ktl_test_failures;\n    ");
                    sb_append(runner_buf, fname);
                    sb_append(runner_buf, "();\n    if (ktl_test_failures == before) {\n");
                    sb_append(runner_buf, "        printf(\"  PASS  %s\", ktl_test_current); puts(\"\");\n");
                    sb_append(runner_buf, "    } else {\n        failed_tests++;\n    }\n");
                    test_n += 1;
                    continue;
                }

                // Normal build: strip the block so it costs nothing at runtime.
                if pos < len && str_char_at(src, pos) == 123 {
                    pos += 1;
                    mut depth := 1;
                    while pos < len && depth > 0 {
                        ch := str_char_at(src, pos);
                        if ch == 123 { depth += 1; }
                        else if ch == 125 { depth -= 1; }
                        pos += 1;
                    }
                }
                continue;
            }

            if str_eq(word, "mut") {
                // `mut x = 5` carries no type annotation. Emit an inferred
                // declaration; without this the name was used before being
                // declared and C reported an undeclared identifier.
                // `mut int x = 1` and `mut x := 5` keep their existing paths.
                mut mq := pos;
                while mq < len && is_space(str_char_at(src, mq)) { mq += 1; }
                ns2 := mq;
                while mq < len && is_alnum(str_char_at(src, mq)) { mq += 1; }
                first := str_sub(src, ns2, mq - ns2);
                mut mq2 := mq;
                while mq2 < len && is_space(str_char_at(src, mq2)) { mq2 += 1; }
                is_type_word := str_eq(first, "int") || str_eq(first, "str") || str_eq(first, "bool") || str_eq(first, "float") || str_eq(first, "i64") || str_eq(first, "u64") || str_eq(first, "vec") || str_eq(first, "sb");
                plain_assign := mq2 < len && str_char_at(src, mq2) == 61 && (mq2 + 1 >= len || str_char_at(src, mq2 + 1) != 61);
                if str_len(first) > 0 && !is_type_word && plain_assign {
                    sb_append(out_buf, "__auto_type ");
                }
                // `mut x := 5` is mutable; a bare `x := 5` is not. The
                // `:=` handler below needs to know which, so that it emits the
                // same `const` qualifier the Python bootstrap compiler does.
                if str_len(first) > 0 && !is_type_word {
                    if mq2 + 1 < len && str_char_at(src, mq2) == 58 && str_char_at(src, mq2 + 1) == 61 {
                        pending_inferred_mut = true;
                    }
                }
                continue;
            }

            // Look ahead for :=
            mut look := pos;
            while look < len && is_space(str_char_at(src, look)) { look += 1; }
            if look + 1 < len && str_char_at(src, look) == 58 && str_char_at(src, look + 1) == 61 { // ':='
                // Match the Python bootstrap compiler, which emits `const` for
                // an inferred declaration that was not written with `mut`.
                // The two disagreed, so code could self-host here but fail to
                // bootstrap -- a divergence that hid real errors.
                if pending_inferred_mut {
                    sb_append(out_buf, "__auto_type ");
                } else {
                    sb_append(out_buf, "const __auto_type ");
                }
                pending_inferred_mut = false;
                sb_append(out_buf, word);
                sb_append(out_buf, " = ");
                pos = look + 2;

                // Classify the initialiser so `value.type` can be answered at
                // compile time (no runtime type tags, no allocation).
                mut v := pos;
                while v < len && is_space(str_char_at(src, v)) { v += 1; }
                mut str iname = "int";
                if v < len && str_char_at(src, v) == 34 { // '"'
                    iname = "str";
                } else if v < len && is_digit(str_char_at(src, v)) {
                    mut w := v;
                    while w < len && (is_digit(str_char_at(src, w)) || str_char_at(src, w) == 46) {
                        if str_char_at(src, w) == 46 { iname = "float"; }
                        w += 1;
                    }
                } else if v + 4 <= len && str_eq(str_sub(src, v, 4), "true") {
                    iname = "bool";
                } else if v + 5 <= len && str_eq(str_sub(src, v, 5), "false") {
                    iname = "bool";
                } else {
                    mut int head_len = 32;
                    if v + head_len > len { head_len = len - v; }
                    str head = str_sub(src, v, head_len);
                    str kind = infer_init_kind(head);
                    if !(str_eq(kind, "int")) {
                        iname = kind;
                    } else {
                        // Struct literal `Point{...}` -> type Point for `.type`.
                        if v < len && str_char_at(src, v) >= 65 && str_char_at(src, v) <= 90 {
                            mut int q = v;
                            while q < len && is_alnum(str_char_at(src, q)) { q += 1; }
                            mut int r = q;
                            while r < len && is_space(str_char_at(src, r)) { r += 1; }
                            if r < len && str_char_at(src, r) == 123 {
                                iname = str_sub(src, v, q - v);
                            }
                        }
                    }
                }
                type_map = str_concat(type_map, str_concat(word, str_concat("=", str_concat(iname, "|"))));
                continue;
            }

            if str_eq(word, "int") { sb_append(out_buf, "ktl_int"); continue; }
            if str_eq(word, "str") { sb_append(out_buf, "ktl_str"); continue; }
            if str_eq(word, "bool") { sb_append(out_buf, "ktl_bool"); continue; }
            if str_eq(word, "float") { sb_append(out_buf, "ktl_float"); continue; }
            if str_eq(word, "i64") { sb_append(out_buf, "ktl_i64"); continue; }
            if str_eq(word, "u64") { sb_append(out_buf, "ktl_u64"); continue; }
            if str_eq(word, "usize") { sb_append(out_buf, "ktl_usize"); continue; }
            if str_eq(word, "raw") {
                // `raw { ... }`: no distinct semantics yet, but the block is
                // accepted and the intent stays visible in the generated C.
                mut rlook := pos;
                while rlook < len && is_space(str_char_at(src, rlook)) { rlook += 1; }
                if rlook < len && str_char_at(src, rlook) == 123 { // '{'
                    pos = rlook + 1;
                    if in_main { main_depth += 1; }
                    if fn_depth > 0 { fn_depth += 1; }
                    sb_append(out_buf, "/* raw */ {");
                    continue;
                }
            }
            // `vec`, `sb`, `arena` and `byte` are also plausible VARIABLE
            // names, so they count as types only when a declared name follows.
            // Without this guard `sb_append(sb, "x")` rewrote its argument to
            // `ktl_sb`, and a variable named `arena` became `ktl_arena`.
            if str_eq(word, "vec") || str_eq(word, "sb") || str_eq(word, "arena") || str_eq(word, "byte") {
                mut look := pos;
                while look < len && is_space(str_char_at(src, look)) { look += 1; }
                id_start := look;
                while look < len && is_alnum(str_char_at(src, look)) { look += 1; }
                if look > id_start {
                    sb_append(out_buf, c_type_of(word));
                    continue;
                }
                sb_append(out_buf, word);
                continue;
            }
            if str_eq(word, "loop") { sb_append(out_buf, "while (1)"); continue; }

            // Print and Println
            if str_eq(word, "println") || str_eq(word, "print") {
                is_nl := str_eq(word, "println");
                while pos < len && str_char_at(src, pos) != 40 { pos += 1; }
                if pos < len && str_char_at(src, pos) == 40 { pos += 1; }

                mut depth := 1;
                arg_start := pos;
                while pos < len && depth > 0 {
                    ch := str_char_at(src, pos);
                    if ch == 34 { // string literal inside print
                        pos += 1;
                        while pos < len && str_char_at(src, pos) != 34 {
                            if str_char_at(src, pos) == 92 { pos += 1; }
                            pos += 1;
                        }
                    } else if ch == 40 {
                        depth += 1;
                    } else if ch == 41 {
                        depth -= 1;
                        if depth == 0 { break; }
                    }
                    pos += 1;
                }
                print_args_str := str_sub(src, arg_start, pos - arg_start);
                pos += 1; // skip ')'

                emit_print(&out_buf, print_args_str, is_nl, type_map, enum_names, ref_fields, ref_params);
                continue;
            }

            if str_eq(word, "return") {
                // Postfix guard clause: `return if cond;` -> `if (cond) return;`
                // Without this the bare `if` fell through to the statement
                // handler, which consumed the rest of the block -- including
                // any `fn main` that followed.
                mut g := pos;
                while g < len && is_space(str_char_at(src, g)) { g += 1; }
                if g + 2 <= len && str_eq(str_sub(src, g, 2), "if") {
                    if g + 2 >= len || !is_alnum(str_char_at(src, g + 2)) {
                        mut cs := g + 2;
                        mut cd := 0;
                        while cs < len {
                            gc := str_char_at(src, cs);
                            if gc == 40 || gc == 91 { cd += 1; }
                            else if gc == 41 || gc == 93 { cd -= 1; }
                            else if gc == 59 && cd == 0 { break; } // ';'
                            cs += 1;
                        }
                        cond := trim_string(str_sub(src, g + 2, cs - (g + 2)));
                        sb_append(out_buf, "if (");
                        sb_append(out_buf, cond);
                        if cur_void {
                            sb_append(out_buf, ") return;");
                        } else {
                            sb_append(out_buf, ") return 0;");
                        }
                        pos = cs;
                        if pos < len { pos += 1; }
                        continue;
                    }
                }
                if in_main {
                    mut look := pos;
                    while look < len && is_space(str_char_at(src, look)) { look += 1; }
                    if look < len && str_char_at(src, look) == 59 { // ';'
                        if main_void {
                            sb_append(out_buf, "return");
                        } else {
                            sb_append(out_buf, "return 0");
                        }
                        continue;
                    }
                }
                sb_append(out_buf, "return");
                continue;
            }

            if str_eq(word, "break") || str_eq(word, "continue") {
                mut g := pos;
                while g < len && is_space(str_char_at(src, g)) { g += 1; }
                if g + 2 <= len && str_eq(str_sub(src, g, 2), "if") {
                    if g + 2 >= len || !is_alnum(str_char_at(src, g + 2)) {
                        mut cs := g + 2;
                        mut cd := 0;
                        while cs < len {
                            gc := str_char_at(src, cs);
                            if gc == 40 || gc == 91 { cd += 1; }
                            else if gc == 41 || gc == 93 { cd -= 1; }
                            else if gc == 59 && cd == 0 { break; } // ';'
                            cs += 1;
                        }
                        cond := trim_string(str_sub(src, g + 2, cs - (g + 2)));
                        sb_append(out_buf, "if (");
                        sb_append(out_buf, cond);
                        sb_append(out_buf, ") ");
                        sb_append(out_buf, word);
                        sb_append(out_buf, ";");
                        pos = cs;
                        if pos < len { pos += 1; }
                        continue;
                    }
                }
                sb_append(out_buf, word);
                continue;
            }

            // Aggregate type definitions -> C typedefs.
            if str_eq(word, "struct") || str_eq(word, "enum") {
                kind := word;
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                ns := pos;
                while pos < len && is_alnum(str_char_at(src, pos)) { pos += 1; }
                tname := str_sub(src, ns, pos - ns);
                if str_eq(kind, "struct") {
                    struct_names = str_concat(struct_names, str_concat(tname, "|"));
                } else {
                    enum_names = str_concat(enum_names, str_concat(tname, "|"));
                }
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                if pos < len && str_char_at(src, pos) == 123 { pos += 1; }
                sb_append(out_buf, "typedef ");
                sb_append(out_buf, kind);
                sb_append(out_buf, " ");
                sb_append(out_buf, tname);
                sb_append(out_buf, " {");
                def_name = tname;
                def_depth = 1;
                in_type_def = true;
                continue;
            }

            // Match statement -> a block of if/else-if comparisons.
            if str_eq(word, "match") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                s_start := pos;
                mut d := 0;
                while pos < len {
                    ch := str_char_at(src, pos);
                    if ch == 40 || ch == 91 { d += 1; }
                    else if ch == 41 || ch == 93 { d -= 1; }
                    else if ch == 123 && d == 0 { break; }
                    pos += 1;
                }
                subj := trim_string(str_sub(src, s_start, pos - s_start));
                if pos < len && str_char_at(src, pos) == 123 { pos += 1; }
                match_n += 1;
                match_var = str_concat("_ktl_m", str_int(match_n));
                match_first = true;
                in_match = true;
                match_depth = 1;
                sb_append(out_buf, " { __auto_type ");
                sb_append(out_buf, match_var);
                sb_append(out_buf, " = ");
                sb_append(out_buf, subj);
                sb_append(out_buf, "; ");
                continue;
            }

            // `case .Variant:` inside a match body.
            if in_match && str_eq(word, "case") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }
                if pos < len && str_char_at(src, pos) == 46 { pos += 1; } // '.'
                vs := pos;
                while pos < len && is_alnum(str_char_at(src, pos)) { pos += 1; }
                vname := str_sub(src, vs, pos - vs);
                while pos < len && str_char_at(src, pos) != 58 { pos += 1; } // ':'
                if pos < len { pos += 1; }
                if match_first {
                    sb_append(out_buf, "if (");
                    match_first = false;
                } else {
                    sb_append(out_buf, "else if (");
                }
                sb_append(out_buf, match_var);
                sb_append(out_buf, " == ");
                sb_append(out_buf, vname);
                sb_append(out_buf, ") ");
                continue;
            }

            // Enum variant access: `Color.Green` -> `Green` (flat constants).
            if str_contains(enum_names, str_concat("|", str_concat(word, "|"))) {
                mut look := pos;
                while look < len && is_space(str_char_at(src, look)) { look += 1; }
                if look < len && str_char_at(src, look) == 46 { // '.'
                    pos = look + 1;
                    continue;
                }
            }

            // Struct literal: `Point{ ... }` -> `(Point){ ... }`.
            if str_contains(struct_names, str_concat("|", str_concat(word, "|"))) {
                mut look := pos;
                while look < len && is_space(str_char_at(src, look)) { look += 1; }
                if look < len && str_char_at(src, look) == 123 { // '{'
                    sb_append(out_buf, "(");
                    sb_append(out_buf, word);
                    sb_append(out_buf, ")");
                    in_init = true;
                    init_depth = 0;
                    continue;
                }
            }

            // Inside a struct literal, `field = value` and `field: value` both
            // need a C99 designator. The colon form is only recognised at the
            // start of a field, so a ternary in a value (`{ x: a ? b : c }`) is
            // not mistaken for a designator.
            if in_init {
                mut look := pos;
                while look < len && is_space(str_char_at(src, look)) { look += 1; }
                if look < len && str_char_at(src, look) == 61 { // '='
                    if look + 1 >= len || str_char_at(src, look + 1) != 61 {
                        sb_append_char(out_buf, 46); // '.'
                        if str_contains(ref_fields, str_concat("|", str_concat(word, "|"))) {
                            init_amp_field = true;
                        }
                    }
                } else if look < len && str_char_at(src, look) == 58 { // ':'
                    // Only a designator when the field directly follows `{` or
                    // `,`, so a ternary in a value is left alone.
                    mut b := start;
                    while b > 0 && is_space(str_char_at(src, b - 1)) { b -= 1; }
                    if b > 0 {
                        pc := str_char_at(src, b - 1);
                        if pc == 123 || pc == 44 { // '{' or ','
                            sb_append_char(out_buf, 46); // '.'
                            init_colon_pending = true;
                            if str_contains(ref_fields, str_concat("|", str_concat(word, "|"))) {
                                init_amp_field = true;
                            }
                        }
                    }
                }
            }

            // `value.type` on an inferred variable, resolved at compile time.
            if str_contains(type_map, str_concat("|", str_concat(word, "="))) {
                mut tlook := pos;
                while tlook < len && is_space(str_char_at(src, tlook)) { tlook += 1; }
                if tlook + 5 <= len && str_eq(str_sub(src, tlook, 5), ".type") {
                    resolved := type_of(type_map, word);
                    sb_append_char(out_buf, 34); // '"'
                    sb_append(out_buf, resolved);
                    sb_append_char(out_buf, 34);
                    pos = tlook + 5;
                    continue;
                }
            }

            // Reference parameters are C pointers; dereference every use.
            if str_contains(ref_params, str_concat("|", str_concat(word, "|"))) {
                mut rl := pos;
                while rl < len && is_space(str_char_at(src, rl)) { rl += 1; }
                if rl < len && str_char_at(src, rl) == 46 { // '.'
                    // Member access through a pointer uses `->`, and a field
                    // that is itself a reference needs a dereference too.
                    fs := rl + 1;
                    mut fe := fs;
                    while fe < len && is_alnum(str_char_at(src, fe)) { fe += 1; }
                    fld := str_sub(src, fs, fe - fs);
                    if str_len(fld) > 0 && str_contains(ref_fields, str_concat("|", str_concat(fld, "|"))) {
                        sb_append(out_buf, "(*");
                        sb_append(out_buf, word);
                        sb_append(out_buf, "->");
                        sb_append(out_buf, fld);
                        sb_append(out_buf, ")");
                        pos = fe;
                        continue;
                    }
                    sb_append(out_buf, word);
                    sb_append(out_buf, "->");
                    pos = rl + 1;
                    continue;
                }
                sb_append_char(out_buf, 42); // '*'
                sb_append(out_buf, word);
                continue;
            }

            // A struct *value* with a reference field: `a.balance` holds a
            // pointer, so reading the referenced value needs a dereference.
            if str_len(ref_fields) > 1 {
                mut vl := pos;
                while vl < len && is_space(str_char_at(src, vl)) { vl += 1; }
                if vl < len && str_char_at(src, vl) == 46 { // '.'
                    fs := vl + 1;
                    mut fe := fs;
                    while fe < len && is_alnum(str_char_at(src, fe)) { fe += 1; }
                    fld := str_sub(src, fs, fe - fs);
                    if str_len(fld) > 0 && str_contains(ref_fields, str_concat("|", str_concat(fld, "|"))) {
                        sb_append(out_buf, "(*");
                        sb_append(out_buf, word);
                        sb_append(out_buf, ".");
                        sb_append(out_buf, fld);
                        sb_append(out_buf, ")");
                        pos = fe;
                        continue;
                    }
                }
            }

            // Normal word
            sb_append(out_buf, word);
            continue;
        }

        // Reference struct fields: `struct S { int &balance; }` declares a
        // pointer member, so the `&` becomes `*`.
        if c == 38 && in_type_def {
            mut q := pos + 1;
            while q < len && is_space(str_char_at(src, q)) { q += 1; }
            ns := q;
            while q < len && is_alnum(str_char_at(src, q)) { q += 1; }
            if q > ns {
                fname := str_sub(src, ns, q - ns);
                ref_fields = str_concat(ref_fields, str_concat("|", str_concat(fname, "|")));
                sb_append_char(out_buf, 42); // '*'
                pos = ns;
                continue;
            }
        }

        // `field = value` in a struct literal: the separator ends the
        // designator, so arm the address-of for the value.
        if c == 61 && in_init && init_amp_field {
            sb_append_char(out_buf, 61); // '='
            init_amp_field = false;
            init_amp_next = true;
            pos += 1;
            continue;
        }

        // The colon of a `field:` designator becomes `=`.
        if c == 58 && init_colon_pending {
            sb_append_char(out_buf, 61); // '='
            init_colon_pending = false;
            if init_amp_field {
                init_amp_field = false;
                init_amp_next = true;
            }
            pos += 1;
            continue;
        }

        // Pointer types: `*mut T` -> `T*`, `*const T` -> `const T*`.
        // Only recognised when `mut`/`const` follows, so multiplication and
        // dereference (`*p`, `a * b`) are left alone.
        if c == 42 { // '*'
            mut p := pos + 1;
            while p < len && is_space(str_char_at(src, p)) { p += 1; }
            mut is_const := false;
            mut matched := false;
            if p + 3 <= len && str_eq(str_sub(src, p, 3), "mut") {
                if p + 3 >= len || !is_alnum(str_char_at(src, p + 3)) {
                    matched = true;
                    p += 3;
                }
            } else if p + 5 <= len && str_eq(str_sub(src, p, 5), "const") {
                if p + 5 >= len || !is_alnum(str_char_at(src, p + 5)) {
                    matched = true;
                    is_const = true;
                    p += 5;
                }
            }
            if matched {
                while p < len && is_space(str_char_at(src, p)) { p += 1; }
                ts := p;
                while p < len && is_alnum(str_char_at(src, p)) { p += 1; }
                if p > ts {
                    if is_const { sb_append(out_buf, "const "); }
                    sb_append(out_buf, c_type_of(str_sub(src, ts, p - ts)));
                    sb_append(out_buf, "*");
                    pos = p;
                    continue;
                }
            }
        }

        // Opening brace '{'
        if c == 123 { // '{'
            if in_main {
                main_depth += 1;
            }
            if in_type_def {
                def_depth += 1;
            }
            if in_init {
                init_depth += 1;
            }
            if in_match {
                match_depth += 1;
            }
            if fn_depth > 0 {
                fn_depth += 1;
            }
            sb_append_char(out_buf, 123);
            pos += 1;
            continue;
        }

        // Closing brace '}'
        if c == 125 { // '}'
            if in_type_def {
                def_depth -= 1;
                if def_depth == 0 {
                    sb_append(out_buf, "} ");
                    sb_append(out_buf, def_name);
                    sb_append(out_buf, ";\n");
                    in_type_def = false;
                    pos += 1;
                    continue;
                }
                sb_append_char(out_buf, 125);
                pos += 1;
                continue;
            }
            if in_match {
                match_depth -= 1;
                if match_depth == 0 {
                    in_match = false;
                }
                sb_append_char(out_buf, 125);
                pos += 1;
                continue;
            }
            if in_init {
                init_depth -= 1;
                if init_depth == 0 {
                    in_init = false;
                }
                sb_append_char(out_buf, 125);
                pos += 1;
                continue;
            }
            if in_main {
                main_depth -= 1;
                if main_depth == 0 {
                    if main_void {
                        sb_append(out_buf, "}\n");
                    } else {
                        sb_append(out_buf, "    return 0;\n}\n");
                    }
                    in_main = false;
                    pos += 1;
                    continue;
                }
            }
            if fn_depth > 0 {
                fn_depth -= 1;
                if fn_depth == 0 {
                    ref_params = "|";
                }
            }
            sb_append_char(out_buf, 125);
            pos += 1;
            continue;
        }

        sb_append_char(out_buf, c);
        pos += 1;
    }

    // In test mode, synthesise the real entry point that drives every
    // `test` block and reports a pass/fail summary.
    if test_mode {
        sb_append(out_buf, "\nint main(int argc, char** argv) {\n");
        sb_append(out_buf, "    ktl_init_args(argc, argv);\n");
        sb_append(out_buf, "    ktl_test_mode = 1;\n");
        sb_append(out_buf, "    int failed_tests = 0;\n");
        sb_append(out_buf, "    int before = 0;\n");
        sb_append(out_buf, sb_build(runner_buf));
        sb_append(out_buf, "    puts(\"\");\n");
        sb_append(out_buf, "    if (failed_tests == 0) {\n");
        sb_append(out_buf, "        printf(\"all ");
        sb_append(out_buf, str_int(test_n));
        sb_append(out_buf, " test(s) passed\"); puts(\"\");\n");
        sb_append(out_buf, "        return 0;\n    }\n");
        sb_append(out_buf, "    printf(\"%d of ");
        sb_append(out_buf, str_int(test_n));
        sb_append(out_buf, " test(s) failed\", failed_tests); puts(\"\");\n");
        sb_append(out_buf, "    return 1;\n}\n");
    }

    result := sb_build(out_buf);
    return result;
}

// -------------------------------------------------------------
// #strict borrow checking
// -------------------------------------------------------------
//
// Enforces the aliasing rule that #strict exists for: within a single call,
// the same variable may not be borrowed mutably (`&x`) more than once, and a
// variable that was never declared `mut` may not be borrowed at all.
//
// `&` is only treated as a borrow when it sits in an argument position, i.e.
// directly after `(` or `,`. That keeps bitwise-and (`count & 1`) from being
// misread as a borrow.
//
// Scope, stated plainly: this is a source-level pass, not a full borrow
// checker. It does not track lifetimes, moves, scopes or struct fields, and
// it uses one flat namespace for mutability. It is deliberately conservative
// and will miss aliasing that a real checker would catch.

// True for the built-in type names, used to tell `mut int x` from `mut x`.
fn is_type_keyword(str w) -> bool {
    if str_eq(w, "int") { return true; }
    if str_eq(w, "str") { return true; }
    if str_eq(w, "bool") { return true; }
    if str_eq(w, "float") { return true; }
    if str_eq(w, "i64") { return true; }
    if str_eq(w, "u64") { return true; }
    if str_eq(w, "vec") { return true; }
    if str_eq(w, "sb") { return true; }
    return false;
}

fn check_borrows(str src, str path) -> int {
    if !str_contains(src, "#strict") {
        return 0;
    }

    mut errors := 0;
    mut line := 1;
    mut i := 0;
    n := str_len(src);

    // Names declared `mut`, as "|x|y|".
    mut str mutables = "|";
    // File-level `mut` declarations, visible to every function. Function
    // scopes start from these rather than carrying names over from whichever
    // function happened to be scanned previously.
    mut str globals = "|";
    mut brace_depth := 0;
    // Borrows seen so far in the call invocation being scanned.
    mut str borrows = "|";

    mut in_call := false;
    mut in_params := false;
    mut depth := 0;
    // Distinguishes `fn f(...)` parameter lists from real call sites.
    mut pending_fn := false;
    mut fn_name_read := false;
    // Previous significant character; used to spot argument positions.
    mut prev := 0;

    while i < n {
        ch := str_char_at(src, i);

        if ch == 10 {
            line += 1;
            i += 1;
            continue;
        }

        // String literals: skip so their contents are not parsed as code.
        if ch == 34 {
            i += 1;
            while i < n {
                sc := str_char_at(src, i);
                if sc == 92 { i += 2; continue; }
                if sc == 34 { i += 1; break; }
                if sc == 10 { line += 1; }
                i += 1;
            }
            prev = 0;
            continue;
        }

        // Line comments
        if ch == 47 && i + 1 < n && str_char_at(src, i + 1) == 47 {
            while i < n && str_char_at(src, i) != 10 { i += 1; }
            continue;
        }

        // Block comments
        if ch == 47 && i + 1 < n && str_char_at(src, i + 1) == 42 {
            i += 2;
            while i + 1 < n {
                if str_char_at(src, i) == 42 && str_char_at(src, i + 1) == 47 { i += 2; break; }
                if str_char_at(src, i) == 10 { line += 1; }
                i += 1;
            }
            continue;
        }

        if ch == 123 { // '{'
            pending_fn = false;
            fn_name_read = false;
            brace_depth += 1;
            prev = 123;
            i += 1;
            continue;
        }

        if ch == 125 { // '}'
            if brace_depth > 0 { brace_depth -= 1; }
            prev = 125;
            i += 1;
            continue;
        }

        if ch == 40 { // '('
            if pending_fn && fn_name_read {
                in_params = true;
                pending_fn = false;
                fn_name_read = false;
            } else {
                in_call = true;
                borrows = "|";
            }
            depth += 1;
            prev = 40;
            i += 1;
            continue;
        }

        if ch == 41 { // ')'
            depth -= 1;
            if depth <= 0 {
                depth = 0;
                in_call = false;
                in_params = false;
            }
            prev = 41;
            i += 1;
            continue;
        }

        // `&name`: a mutable borrow in an argument position, or a reference
        // parameter declaration (`int &a`) inside a `fn` parameter list.
        // Requiring `(`/`,`/in_params keeps bitwise-and (`count & 1`) from
        // being misread as a borrow.
        if ch == 38 && (prev == 40 || prev == 44 || in_params) {
            mut j := i + 1;
            while j < n && is_space(str_char_at(src, j)) { j += 1; }
            ns := j;
            while j < n && is_alnum(str_char_at(src, j)) { j += 1; }
            if j > ns && !is_digit(str_char_at(src, ns)) {
                base_name := str_sub(src, ns, j - ns);
                // A field access borrows only that field, so `f(&p.x, &p.y)`
                // is not aliasing while `f(&p.x, &p.x)` is. The borrow key
                // carries the field; the mutability check uses the base name.
                mut key_name := base_name;
                mut k := j;
                while k < n && is_space(str_char_at(src, k)) { k += 1; }
                if k < n && str_char_at(src, k) == 46 { // '.'
                    mut fe := k + 1;
                    while fe < n && is_alnum(str_char_at(src, fe)) { fe += 1; }
                    if fe > k + 1 {
                        key_name = str_concat(base_name, str_sub(src, k, fe - k));
                        j = fe;
                    }
                }
                key := str_concat("|", str_concat(key_name, "|"));
                base_key := str_concat("|", str_concat(base_name, "|"));
                if in_params {
                    // A `&` parameter is itself a mutable reference.
                    mutables = str_concat(mutables, base_key);
                } else {
                    if str_contains(borrows, key) {
                        println("\x1b[1;31merror\x1b[0m: cannot borrow `%` as mutable more than once at a time", key_name);
                        println("  --> %:%", path, line);
                        println("   = note: #strict forbids aliased mutable references (&)");
                        errors += 1;
                    }
                    borrows = str_concat(borrows, key);
                    if !str_contains(mutables, base_key) {
                        println("\x1b[1;31merror\x1b[0m: cannot borrow `%` as mutable because it is not declared `mut`", base_name);
                        println("  --> %:%", path, line);
                        println("   = help: declare it as `mut int % = ...;` or `mut % := ...;`", base_name, base_name);
                        errors += 1;
                    }
                }
                i = j;
                prev = 0;
                continue;
            }
            prev = 38;
            i += 1;
            continue;
        }

        // Identifiers: record `mut` declarations, and note when a `fn`
        // name has been read so the next `(` is recognised as a parameter list.
        if is_alpha(ch) {
            ws := i;
            while i < n && is_alnum(str_char_at(src, i)) { i += 1; }
            w := str_sub(src, ws, i - ws);

            if str_eq(w, "fn") {
                pending_fn = true;
                fn_name_read = false;
                // Each function gets a fresh mutability scope, so a name
                // declared `mut` in one function is not treated as mutable in
                // another. File-level declarations remain visible.
                mutables = globals;
                prev = 0;
                continue;
            }

            if str_eq(w, "mut") {
                mut k := i;
                while k < n && is_space(str_char_at(src, k)) { k += 1; }
                w1s := k;
                while k < n && is_alnum(str_char_at(src, k)) { k += 1; }
                if k > w1s {
                    w1 := str_sub(src, w1s, k - w1s);
                    mut k2 := k;
                    while k2 < n && is_space(str_char_at(src, k2)) { k2 += 1; }
                    w2s := k2;
                    while k2 < n && is_alnum(str_char_at(src, k2)) { k2 += 1; }
                    // `mut x := 1` names x; `mut int x = 1` names x too.
                    mut dname := w1;
                    if k2 > w2s && is_type_keyword(w1) {
                        dname = str_sub(src, w2s, k2 - w2s);
                    }
                    decl_key := str_concat("|", str_concat(dname, "|"));
                    if brace_depth == 0 {
                        globals = str_concat(globals, decl_key);
                    }
                    mutables = str_concat(mutables, decl_key);
                }
                prev = 0;
                continue;
            }

            if pending_fn && !fn_name_read {
                fn_name_read = true;
            }
            prev = 0;
            continue;
        }

        if ch != 32 && ch != 9 && ch != 13 {
            prev = ch;
        }
        i += 1;
    }

    if errors > 0 {
        println("   = note: % #strict error(s); compilation aborted", errors);
    }
    return errors;
}

// -------------------------------------------------------------
// Argument defaults and named arguments
// -------------------------------------------------------------
//
// C has neither, and a character scanner cannot reorder arguments as it goes.
// So this runs as a source-to-source pass *before* transpilation: call sites
// are rewritten into fully positional form, and the transpiler then sees
// ordinary calls.
//
//   fn greet(str name = "world", int times = 1)
//   greet(times = 3)          ->  greet("world", 3)
//   greet()                   ->  greet("world", 1)
//
// Signatures are collected first, then call sites are rewritten. Anything the
// parser cannot read confidently (a default containing a comma, say) is left
// untouched rather than guessed at, so the worst case is the old behaviour.

// Split on commas that sit at nesting depth zero, into "|a|b|c" form.
fn split_top_commas(str s) -> str {
    mut str out = "|";
    n := str_len(s);
    mut depth := 0;
    mut start := 0;
    mut i := 0;
    while i < n {
        c := str_char_at(s, i);
        if c == 34 { // string literal: skip it whole
            i += 1;
            while i < n {
                sc := str_char_at(s, i);
                if sc == 92 { i += 2; continue; }
                if sc == 34 { i += 1; break; }
                i += 1;
            }
            continue;
        }
        if c == 40 || c == 91 || c == 123 {
            depth += 1;
        } else if c == 41 || c == 93 || c == 125 {
            depth -= 1;
        } else if c == 44 && depth == 0 { // ','
            out = str_concat(out, trim_string(str_sub(s, start, i - start)));
            out = str_concat(out, "|");
            start = i + 1;
        }
        i += 1;
    }
    tail := trim_string(str_sub(s, start, n - start));
    if str_len(tail) > 0 {
        out = str_concat(out, str_concat(tail, "|"));
    }
    return out;
}

// idx-th field of a "|a|b|" list, or "" when out of range.
fn field_at(str list, int idx) -> str {
    n := str_len(list);
    mut i := 0;
    mut f := 0;
    while i < n {
        if str_char_at(list, i) == 124 { // '|'
            i += 1;
            if f == idx {
                s := i;
                while i < n && str_char_at(list, i) != 124 { i += 1; }
                return str_sub(list, s, i - s);
            }
            f += 1;
            continue;
        }
        i += 1;
    }
    return "";
}

fn field_count(str list) -> int {
    mut c := 0;
    n := str_len(list);
    mut i := 0;
    while i < n {
        if str_char_at(list, i) == 124 { c += 1; }
        i += 1;
    }
    return c - 1;
}

// Last identifier in a parameter fragment: `int &timeout` -> "timeout".
fn last_ident(str s) -> str {
    mut str found = "";
    n := str_len(s);
    mut i := 0;
    while i < n {
        if is_alpha(str_char_at(s, i)) {
            ws := i;
            while i < n && is_alnum(str_char_at(s, i)) { i += 1; }
            found = str_sub(s, ws, i - ws);
            continue;
        }
        i += 1;
    }
    return found;
}

// Index of a top-level `=` that is a plain assignment (not ==, <=, >=, !=, :=).
fn find_top_assign(str s) -> int {
    n := str_len(s);
    mut depth := 0;
    mut i := 0;
    while i < n {
        c := str_char_at(s, i);
        if c == 34 {
            i += 1;
            while i < n {
                sc := str_char_at(s, i);
                if sc == 92 { i += 2; continue; }
                if sc == 34 { i += 1; break; }
                i += 1;
            }
            continue;
        }
        if c == 40 || c == 91 || c == 123 {
            depth += 1;
        } else if c == 41 || c == 93 || c == 125 {
            depth -= 1;
        } else if c == 61 && depth == 0 {
            mut prev := 0;
            if i > 0 { prev = str_char_at(s, i - 1); }
            mut next := 0;
            if i + 1 < n { next = str_char_at(s, i + 1); }
            // reject ==, <=, >=, !=, :=
            if next != 61 && prev != 60 && prev != 62 && prev != 33 && prev != 58 {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

// Build "name#p1,p2#d1,d2" for one function, or "" when unparseable.
fn build_signature(str fname, str params) -> str {
    parts := split_top_commas(params);
    np := field_count(parts);
    if np <= 0 {
        return "";
    }
    mut str names = "";
    mut str defs = "";
    mut str refs = "";
    mut i := 0;
    while i < np {
        frag := trim_string(field_at(parts, i));
        if str_len(frag) == 0 {
            return "";
        }
        eq := find_top_assign(frag);
        mut str pname = "";
        mut str pdef = "";
        if eq >= 0 {
            pname = last_ident(str_sub(frag, 0, eq));
            pdef = trim_string(str_sub(frag, eq + 1, str_len(frag) - (eq + 1)));
        } else {
            pname = last_ident(frag);
        }
        if str_len(pname) == 0 {
            return "";
        }
        // A default containing a comma would not survive the encoding below.
        if str_contains(pdef, ",") || str_contains(pdef, "|") || str_contains(pdef, "#") {
            return "";
        }
        if i > 0 {
            names = str_concat(names, ",");
            defs = str_concat(defs, ",");
            refs = str_concat(refs, ",");
        }
        names = str_concat(names, pname);
        defs = str_concat(defs, pdef);
        // A `&` parameter is a pointer in C, so call sites must pass an
        // address. Recorded as 1/0 so the call rewriter knows which positions.
        if str_contains(frag, "&") {
            refs = str_concat(refs, "1");
        } else {
            refs = str_concat(refs, "0");
        }
        i += 1;
    }
    return str_concat(fname, str_concat("#", str_concat(names, str_concat("#", str_concat(defs, str_concat("#", str_concat(refs, "|")))))));
}

fn collect_signatures(str src) -> str {
    mut str sigs = "|";
    n := str_len(src);
    mut i := 0;
    while i < n {
        c := str_char_at(src, i);
        if c == 34 {
            i += 1;
            while i < n {
                sc := str_char_at(src, i);
                if sc == 92 { i += 2; continue; }
                if sc == 34 { i += 1; break; }
                i += 1;
            }
            continue;
        }
        if c == 47 && i + 1 < n && str_char_at(src, i + 1) == 47 {
            while i < n && str_char_at(src, i) != 10 { i += 1; }
            continue;
        }
        if is_alpha(c) {
            ws := i;
            while i < n && is_alnum(str_char_at(src, i)) { i += 1; }
            w := str_sub(src, ws, i - ws);
            if str_eq(w, "fn") {
                while i < n && is_space(str_char_at(src, i)) { i += 1; }
                ns := i;
                while i < n && is_alnum(str_char_at(src, i)) { i += 1; }
                fname := str_sub(src, ns, i - ns);
                while i < n && is_space(str_char_at(src, i)) { i += 1; }
                if i < n && str_char_at(src, i) == 40 { // '('
                    ps := i + 1;
                    mut d := 1;
                    i += 1;
                    while i < n && d > 0 {
                        ch := str_char_at(src, i);
                        if ch == 40 { d += 1; }
                        else if ch == 41 { d -= 1; if d == 0 { break; } }
                        i += 1;
                    }
                    params := str_sub(src, ps, i - ps);
                    if i < n { i += 1; }
                    if str_len(fname) > 0 && !str_eq(fname, "main") {
                        entry := build_signature(fname, params);
                        if str_len(entry) > 0 {
                            sigs = str_concat(sigs, entry);
                        }
                    }
                }
                continue;
            }
            continue;
        }
        i += 1;
    }
    return sigs;
}

fn signature_for(str sigs, str name) -> str {
    prefix := str_concat("|", str_concat(name, "#"));
    idx := str_index_of(sigs, prefix, 0);
    if idx < 0 {
        return "";
    }
    start := idx + 1;
    n := str_len(sigs);
    mut j := start;
    while j < n && str_char_at(sigs, j) != 124 { j += 1; }
    return str_sub(sigs, start, j - start);
}

// Replace field idx of a "|a|b|" list, returning a new list.
fn set_field(str list, int idx, str value) -> str {
    mut out := sb_create(str_len(list) + str_len(value) + 8);
    n := str_len(list);
    mut f := 0;
    mut i := 0;
    while i < n {
        if str_char_at(list, i) == 124 { // '|'
            sb_append_char(out, 124);
            if f == idx {
                sb_append(out, value);
            } else {
                s := i + 1;
                mut j := s;
                while j < n && str_char_at(list, j) != 124 { j += 1; }
                if j > s {
                    sb_append(out, str_sub(list, s, j - s));
                }
            }
            f += 1;
        }
        i += 1;
    }
    return sb_build(out);
}

// Rewrite one call's argument list into fully positional form.
// Returns "" when the call needs no change or cannot be handled safely.
fn positional_args(str sig, str args_text) -> str {
    h1 := str_index_of(sig, "#", 0);
    if h1 < 0 { return ""; }
    h2 := str_index_of(sig, "#", h1 + 1);
    if h2 < 0 { return ""; }
    names := str_sub(sig, h1 + 1, h2 - h1 - 1);
    mut str defs = str_sub(sig, h2 + 1, str_len(sig) - h2 - 1);
    // Optional 4th field: per-parameter "1" when declared with `&`.
    mut str refs = "";
    h3 := str_index_of(defs, "#", 0);
    if h3 >= 0 {
        refs = str_sub(defs, h3 + 1, str_len(defs) - h3 - 1);
        defs = str_sub(defs, 0, h3);
    }

    name_list := split_top_commas(names);
    def_list := split_top_commas(defs);
    ref_list := split_top_commas(refs);
    np := field_count(name_list);

    given := split_top_commas(args_text);
    na := field_count(given);
    // A zero-argument call is legitimate here: every parameter may have a
    // default, in which case the loop below fills all of them in.
    if np <= 0 {
        return "";
    }

    // vals starts as a list of np empty fields: "|" followed by np pipes.
    mut str vals = "|";
    mut i := 0;
    while i < np {
        vals = str_concat(vals, "|");
        i += 1;
    }

    mut any_named := false;
    i = 0;
    while i < na {
        a := trim_string(field_at(given, i));
        eq := find_top_assign(a);
        mut placed := false;
        if eq >= 0 {
            lhs := trim_string(str_sub(a, 0, eq));
            if str_len(lhs) > 0 && is_alpha(str_char_at(lhs, 0)) && !str_contains(lhs, " ") {
                mut k := 0;
                while k < np {
                    if str_eq(field_at(name_list, k), lhs) {
                        val := trim_string(str_sub(a, eq + 1, str_len(a) - (eq + 1)));
                        vals = set_field(vals, k, val);
                        any_named = true;
                        placed = true;
                        break;
                    }
                    k += 1;
                }
            }
        }
        if !placed {
            if any_named {
                return ""; // positional after named is ambiguous
            }
            vals = set_field(vals, i, a);
        }
        i += 1;
    }

    // Fill anything not supplied from the parameter default.
    mut result := sb_create(str_len(args_text) + 64);
    i = 0;
    while i < np {
        mut v := field_at(vals, i);
        if str_len(v) == 0 {
            d := trim_string(field_at(def_list, i));
            if str_len(d) == 0 {
                return ""; // a required parameter is missing; leave it alone
            }
            v = d;
        }
        if i > 0 {
            sb_append(result, ", ");
        }
        // A `&` parameter needs an address at the call site, the same way the
        // Python bootstrap compiler inserts one.
        if str_eq(field_at(ref_list, i), "1") && str_len(v) > 0 {
            c0 := str_char_at(v, 0);
            if c0 != 38 && c0 != 42 { // not already '&' or '*'
                sb_append(result, "&");
            }
        }
        sb_append(result, v);
        i += 1;
    }
    return sb_build(result);
}

fn rewrite_call_args(str src) -> str {
    sigs := collect_signatures(src);
    if str_len(sigs) <= 1 {
        return src;
    }

    mut out := sb_create(str_len(src) + 256);
    n := str_len(src);
    mut i := 0;
    mut after_fn := false;

    while i < n {
        c := str_char_at(src, i);

        // Copy strings, comments and pragmas through untouched.
        if c == 34 {
            sb_append_char(out, c);
            i += 1;
            while i < n {
                sc := str_char_at(src, i);
                if sc == 92 && i + 1 < n {
                    sb_append_char(out, sc);
                    sb_append_char(out, str_char_at(src, i + 1));
                    i += 2;
                    continue;
                }
                sb_append_char(out, sc);
                i += 1;
                if sc == 34 { break; }
            }
            continue;
        }
        if c == 47 && i + 1 < n && (str_char_at(src, i + 1) == 47 || str_char_at(src, i + 1) == 42) {
            sb_append_char(out, c);
            i += 1;
            continue;
        }

        if is_alpha(c) {
            ws := i;
            while i < n && is_alnum(str_char_at(src, i)) { i += 1; }
            w := str_sub(src, ws, i - ws);

            if str_eq(w, "fn") {
                after_fn = true;
                sb_append(out, w);
                continue;
            }

            // whitespace between the callee name and '('
            mut j := i;
            while j < n && is_space(str_char_at(src, j)) { j += 1; }

            if j < n && str_char_at(src, j) == 40 && !after_fn {
                sig := signature_for(sigs, w);
                if str_len(sig) > 0 {
                    // find the matching ')'
                    mut d := 1;
                    mut k := j + 1;
                    while k < n && d > 0 {
                        ch := str_char_at(src, k);
                        if ch == 34 {
                            k += 1;
                            while k < n {
                                if str_char_at(src, k) == 92 { k += 2; continue; }
                                if str_char_at(src, k) == 34 { k += 1; break; }
                                k += 1;
                            }
                            continue;
                        }
                        if ch == 40 { d += 1; }
                        else if ch == 41 { d -= 1; if d == 0 { break; } }
                        k += 1;
                    }
                    if k < n {
                        args_text := str_sub(src, j + 1, k - j - 1);
                        new_args := positional_args(sig, args_text);
                        if str_len(new_args) > 0 {
                            sb_append(out, w);
                            if j > i {
                                sb_append(out, str_sub(src, i, j - i));
                            }
                            sb_append(out, "(");
                            sb_append(out, new_args);
                            sb_append(out, ")");
                            i = k + 1;
                            after_fn = false;
                            continue;
                        }
                    }
                }
            }
            after_fn = false;
            sb_append(out, w);
            continue;
        }

        if c != 32 && c != 9 && c != 13 && c != 10 {
            if c == 40 && after_fn {
                // parameter list of a definition: not a call
            }
            after_fn = false;
        }
        sb_append_char(out, c);
        i += 1;
    }
    return sb_build(out);
}

// -------------------------------------------------------------
// `or` fallback expressions
// -------------------------------------------------------------
//
// `expr or fallback` has no C equivalent, but clang supports GNU statement
// expressions, which give exactly the right evaluation semantics (the left
// side is evaluated once). Statements are buffered so the left-hand side can
// be wrapped after the fact:
//
//   port := parse_int(s) or 8080;
//   ->  port := ({ __auto_type _ktl_opt = parse_int(s);
//                  _ktl_opt ? _ktl_opt : (8080); });
//
// Only statements are rewritten, so an `or` nested inside a call argument is
// left alone rather than guessed at.

fn rewrite_one_or(str stmt) -> str {
    n := str_len(stmt);
    mut depth := 0;
    mut or_pos := -1;
    mut i := 0;
    while i < n {
        c := str_char_at(stmt, i);
        if c == 34 { // string
            i += 1;
            while i < n {
                sc := str_char_at(stmt, i);
                if sc == 92 { i += 2; continue; }
                if sc == 34 { i += 1; break; }
                i += 1;
            }
            continue;
        }
        if c == 47 && i + 1 < n && str_char_at(stmt, i + 1) == 47 { // line comment
            while i < n && str_char_at(stmt, i) != 10 { i += 1; }
            continue;
        }
        if c == 40 || c == 91 { depth += 1; }
        else if c == 41 || c == 93 { depth -= 1; }
        else if c == 32 && depth == 0 && i + 4 <= n {
            if str_eq(str_sub(stmt, i, 4), " or ") {
                or_pos = i;
                break;
            }
        }
        i += 1;
    }
    if or_pos < 0 {
        return "";
    }

    left := str_sub(stmt, 0, or_pos);
    right := trim_string(str_sub(stmt, or_pos + 4, n - or_pos - 4));
    if str_len(right) == 0 {
        return "";
    }

    // Where does the expression being guarded start?
    ln := str_len(left);
    mut prefix_end := 0;
    mut d2 := 0;
    mut j := 0;
    while j < ln {
        c := str_char_at(left, j);
        if c == 34 {
            j += 1;
            while j < ln {
                sc := str_char_at(left, j);
                if sc == 92 { j += 2; continue; }
                if sc == 34 { j += 1; break; }
                j += 1;
            }
            continue;
        }
        if c == 40 || c == 91 { d2 += 1; }
        else if c == 41 || c == 93 { d2 -= 1; }
        else if d2 == 0 && c == 58 && j + 1 < ln && str_char_at(left, j + 1) == 61 { // ':='
            prefix_end = j + 2;
            j += 1;
        } else if d2 == 0 && c == 61 { // '='
            mut prev := 0;
            if j > 0 { prev = str_char_at(left, j - 1); }
            mut next := 0;
            if j + 1 < ln { next = str_char_at(left, j + 1); }
            if next != 61 && prev != 60 && prev != 62 && prev != 33 && prev != 58 {
                prefix_end = j + 1;
            }
        }
        j += 1;
    }
    if prefix_end == 0 {
        // `return expr or fallback`
        mut k := 0;
        while k < ln && is_space(str_char_at(left, k)) { k += 1; }
        if k + 6 <= ln && str_eq(str_sub(left, k, 6), "return") {
            mut r := k + 6;
            while r < ln && is_space(str_char_at(left, r)) { r += 1; }
            prefix_end = r;
        }
    }
    if prefix_end == 0 {
        return ""; // cannot tell where the guarded expression begins
    }

    prefix := str_sub(left, 0, prefix_end);
    lhs := trim_string(str_sub(left, prefix_end, ln - prefix_end));
    if str_len(lhs) == 0 {
        return "";
    }

    mut res := sb_create(str_len(stmt) + 96);
    sb_append(res, prefix);
    if str_eq(right, "return") {
        // The braces matter: the transpiler's `if` handler looks for a `{` to
        // find where the condition ends, so an unbraced `if` here would
        // swallow the rest of the file.
        sb_append(res, "({ __auto_type _ktl_opt = ");
        sb_append(res, lhs);
        sb_append(res, "; if (!_ktl_opt) { return; } _ktl_opt; })");
    } else if str_starts_with(right, "panic(") || str_starts_with(right, "assert(") {
        // A comma expression keeps `if` out of the generated code entirely.
        sb_append(res, "({ __auto_type _ktl_opt = ");
        sb_append(res, lhs);
        sb_append(res, "; _ktl_opt ? _ktl_opt : (");
        sb_append(res, right);
        sb_append(res, ", 0); })");
    } else {
        sb_append(res, "({ __auto_type _ktl_opt = ");
        sb_append(res, lhs);
        sb_append(res, "; _ktl_opt ? _ktl_opt : (");
        sb_append(res, right);
        sb_append(res, "); })");
    }
    return sb_build(res);
}

fn rewrite_or_fallbacks(str src) -> str {
    if !str_contains(src, " or ") {
        return src;
    }
    mut out := sb_create(str_len(src) + 128);
    mut stmt := sb_create(512);
    n := str_len(src);
    mut i := 0;
    mut depth := 0;

    while i < n {
        c := str_char_at(src, i);

        if c == 34 { // string: copy straight through
            sb_append_char(stmt, c);
            i += 1;
            while i < n {
                sc := str_char_at(src, i);
                sb_append_char(stmt, sc);
                i += 1;
                if sc == 92 && i < n {
                    sb_append_char(stmt, str_char_at(src, i));
                    i += 1;
                    continue;
                }
                if sc == 34 { break; }
            }
            continue;
        }

        if c == 123 || c == 125 { // '{' or '}'
            flush := rewrite_one_or(sb_build(stmt));
            if str_len(flush) > 0 {
                sb_append(out, flush);
            } else {
                sb_append(out, sb_build(stmt));
            }
            stmt = sb_create(512);
            sb_append_char(out, c);
            i += 1;
            continue;
        }

        if c == 59 && depth == 0 { // ';'
            flush := rewrite_one_or(sb_build(stmt));
            if str_len(flush) > 0 {
                sb_append(out, flush);
            } else {
                sb_append(out, sb_build(stmt));
            }
            stmt = sb_create(512);
            sb_append_char(out, 59);
            i += 1;
            continue;
        }

        if c == 40 || c == 91 { depth += 1; }
        else if c == 41 || c == 93 { depth -= 1; }
        sb_append_char(stmt, c);
        i += 1;
    }

    tail := rewrite_one_or(sb_build(stmt));
    if str_len(tail) > 0 {
        sb_append(out, tail);
    } else {
        sb_append(out, sb_build(stmt));
    }
    return sb_build(out);
}

// -------------------------------------------------------------
// Compilation Pipeline Execution
// -------------------------------------------------------------

// Resolve the directory holding katlin_runtime.h so that projects living
// outside the Katlin repository still compile. Search order:
//   1. $KATLIN_STD                      (explicit override)
//   2. <compiler_dir>/../std            (checkout layout)
//   3. <compiler_dir>/../lib/katlin/std (installed layout, see install.sh)
//   4. ./std                            (running from the repository root)
fn find_std_dir() -> str {
    override := env_get("KATLIN_STD");
    if str_len(override) > 0 {
        return override;
    }

    dir := path_dir(args_get(0));
    if str_len(dir) > 0 {
        checkout := str_concat(dir, "/../std");
        if file_exists(str_concat(checkout, "/katlin_runtime.h")) {
            return checkout;
        }
        installed := str_concat(dir, "/../lib/katlin/std");
        if file_exists(str_concat(installed, "/katlin_runtime.h")) {
            return installed;
        }
    }
    if file_exists("std/katlin_runtime.h") {
        return "std";
    }
    return "std";
}

// Read `opt_level = N` from ./katlin.toml, or -1 when there is no such file
// or key. The scaffold written by `katlin init` produces this file; without
// this lookup the setting it contains had no effect at all.
fn toml_opt_level() -> int {
    if !file_exists("katlin.toml") {
        return -1;
    }
    txt := file_read("katlin.toml");
    idx := str_index_of(txt, "opt_level", 0);
    if idx < 0 {
        return -1;
    }
    mut i := idx + 9;
    n := str_len(txt);
    while i < n && (str_char_at(txt, i) == 32 || str_char_at(txt, i) == 9) { i += 1; }
    if i >= n || str_char_at(txt, i) != 61 { // '='
        return -1;
    }
    i += 1;
    while i < n && (str_char_at(txt, i) == 32 || str_char_at(txt, i) == 9) { i += 1; }
    if i >= n || !is_digit(str_char_at(txt, i)) {
        return -1;
    }
    mut val := 0;
    while i < n && is_digit(str_char_at(txt, i)) {
        val = val * 10 + (str_char_at(txt, i) - 48);
        i += 1;
    }
    return val;
}

fn normalize_module_path(str raw_path) -> str {
    trimmed := trim_string(raw_path);
    if str_ends_with(trimmed, ".ktl") {
        return trimmed;
    }
    mut buf := sb_create(str_len(trimmed) + 8);
    rn := str_len(trimmed);
    mut k := 0;
    while k < rn {
        ch := str_char_at(trimmed, k);
        if ch == 46 { // '.'
            sb_append_char(buf, 47); // '/'
        } else {
            sb_append_char(buf, ch);
        }
        k += 1;
    }
    sb_append(buf, ".ktl");
    res := sb_build(buf);
    return res;
}

fn resolve_module_file(str current_file, str target) -> str {
    dir := path_dir(current_file);
    mut str clean_target = target;
    if str_starts_with(clean_target, "./") {
        clean_target = str_sub(clean_target, 2, str_len(clean_target) - 2);
    }

    // Check 1: relative to current file's directory
    mut str cand = clean_target;
    if !str_eq(dir, ".") && str_len(dir) > 0 {
        cand = str_concat(dir, str_concat("/", clean_target));
    }
    if file_exists(cand) {
        return cand;
    }

    // Check 2: relative to current working directory
    if file_exists(clean_target) {
        return clean_target;
    }

    return "";
}

fn resolve_imports(str current_file, str src, sb &visited_sb, sb &err_sb) -> str {
    len := str_len(src);
    mut pos := 0;
    mut modules_sb := sb_create(2048);
    mut clean_sb := sb_create(len + 64);

    while pos < len {
        c := str_char_at(src, pos);

        // Skip single-line comments
        if c == 47 && pos + 1 < len && str_char_at(src, pos + 1) == 47 {
            while pos < len && str_char_at(src, pos) != 10 {
                sb_append_char(clean_sb, str_char_at(src, pos));
                pos += 1;
            }
            continue;
        }

        // Skip multi-line comments
        if c == 47 && pos + 1 < len && str_char_at(src, pos + 1) == 42 {
            sb_append(clean_sb, "/*");
            pos += 2;
            while pos + 1 < len {
                if str_char_at(src, pos) == 42 && str_char_at(src, pos + 1) == 47 {
                    pos += 2;
                    sb_append(clean_sb, "*/");
                    break;
                }
                sb_append_char(clean_sb, str_char_at(src, pos));
                pos += 1;
            }
            continue;
        }

        // Skip string literals
        if c == 34 {
            sb_append_char(clean_sb, 34);
            pos += 1;
            while pos < len {
                sc := str_char_at(src, pos);
                if sc == 92 && pos + 1 < len {
                    sb_append_char(clean_sb, 92);
                    sb_append_char(clean_sb, str_char_at(src, pos + 1));
                    pos += 2;
                    continue;
                }
                if sc == 34 {
                    sb_append_char(clean_sb, 34);
                    pos += 1;
                    break;
                }
                sb_append_char(clean_sb, sc);
                pos += 1;
            }
            continue;
        }

        // Identifier or keyword
        if is_alpha(c) {
            start := pos;
            while pos < len && is_alnum(str_char_at(src, pos)) { pos += 1; }
            word := str_sub(src, start, pos - start);

            if str_eq(word, "import") {
                while pos < len && is_space(str_char_at(src, pos)) { pos += 1; }

                mut str raw_target = "";
                if pos < len && str_char_at(src, pos) == 34 {
                    pos += 1;
                    q_start := pos;
                    while pos < len && str_char_at(src, pos) != 34 { pos += 1; }
                    raw_target = str_sub(src, q_start, pos - q_start);
                    if pos < len && str_char_at(src, pos) == 34 { pos += 1; }
                } else {
                    id_start := pos;
                    while pos < len && (is_alnum(str_char_at(src, pos)) || str_char_at(src, pos) == 46 || str_char_at(src, pos) == 47 || str_char_at(src, pos) == 95) {
                        pos += 1;
                    }
                    raw_target = str_sub(src, id_start, pos - id_start);
                }

                while pos < len && str_char_at(src, pos) != 59 && str_char_at(src, pos) != 10 {
                    pos += 1;
                }
                if pos < len && str_char_at(src, pos) == 59 { pos += 1; }

                // Built-in std imports (e.g. std.io, std.mem)
                if str_starts_with(raw_target, "std.") || str_eq(raw_target, "std") {
                    sb_append(clean_sb, "// std import: ");
                    sb_append(clean_sb, raw_target);
                    sb_append_char(clean_sb, 10);
                    continue;
                }

                mod_target := normalize_module_path(raw_target);
                resolved := resolve_module_file(current_file, mod_target);
                if str_len(resolved) == 0 {
                    sb_append(err_sb, str_concat("cannot find imported module '", str_concat(raw_target, str_concat("' referenced in ", current_file))));
                    return "";
                }

                needle := str_concat("|", str_concat(resolved, "|"));
                if str_contains(sb_build(visited_sb), needle) {
                    sb_append(clean_sb, "// already imported: ");
                    sb_append(clean_sb, resolved);
                    sb_append_char(clean_sb, 10);
                    continue;
                }

                sb_append(visited_sb, str_concat(resolved, "|"));

                mod_src := file_read(resolved);
                if str_len(mod_src) == 0 {
                    sb_append(err_sb, str_concat("imported module '", str_concat(resolved, "' is empty")));
                    return "";
                }

                if str_contains(mod_src, "fn main") {
                    sb_append(err_sb, str_concat("imported module '", str_concat(resolved, "' cannot define 'fn main'")));
                    return "";
                }

                if check_borrows(mod_src, resolved) > 0 {
                    sb_append(err_sb, str_concat("#strict borrow check failed in ", resolved));
                    return "";
                }

                nested := resolve_imports(resolved, mod_src, visited_sb, err_sb);
                if str_len(sb_build(err_sb)) > 0 {
                    return "";
                }

                sb_append(modules_sb, "// --- Module: ");
                sb_append(modules_sb, resolved);
                sb_append(modules_sb, " ---\n");
                sb_append(modules_sb, nested);
                sb_append(modules_sb, "\n");

                sb_append(clean_sb, "// imported: ");
                sb_append(clean_sb, resolved);
                sb_append_char(clean_sb, 10);
                continue;
            }

            sb_append(clean_sb, word);
            continue;
        }

        sb_append_char(clean_sb, c);
        pos += 1;
    }

    mut final_sb := sb_create(4096);
    if str_len(sb_build(modules_sb)) > 0 {
        sb_append(final_sb, sb_build(modules_sb));
        sb_append(final_sb, "\n");
    }
    sb_append(final_sb, sb_build(clean_sb));
    res := sb_build(final_sb);
    return res;
}

// check_only: type-check without producing a binary.
fn compile_file(str src_path, str out_binary, bool optimize, bool run_after, str extra_args, str tool_flags, bool check_only) -> int {
    if !file_exists(src_path) {
        println("\x1b[1;31merror\x1b[0m: source file not found: %", src_path);
        return 1;
    }

    src_content := file_read(src_path);
    if str_len(src_content) == 0 {
        println("\x1b[1;31merror\x1b[0m: source file is empty: %", src_path);
        return 1;
    }

    std_dir := find_std_dir();
    if !file_exists(str_concat(std_dir, "/katlin_runtime.h")) {
        println("\x1b[1;31merror\x1b[0m: cannot locate katlin_runtime.h");
        println("  searched: %/katlin_runtime.h", std_dir);
        println("  set KATLIN_STD to the directory that contains it, e.g.");
        println("    KATLIN_STD=/path/to/katlin/std katlin build %", src_path);
        return 1;
    }

    system("mkdir -p .build/bin");

    base_name := path_base(src_path);
    c_path := str_concat(".build/", str_concat(base_name, ".c"));

    // Reject aliased mutable borrows in the root file.
    if check_borrows(src_content, src_path) > 0 {
        return 1;
    }

    // Resolve all imported modules and bundle them in dependency order.
    mut visited_sb := sb_create(256);
    sb_append(visited_sb, "|");
    sb_append(visited_sb, src_path);
    sb_append(visited_sb, "|");

    mut err_sb := sb_create(256);
    bundled_src := resolve_imports(src_path, src_content, &visited_sb, &err_sb);
    if str_len(sb_build(err_sb)) > 0 {
        println("\x1b[1;31merror\x1b[0m: %", sb_build(err_sb));
        return 1;
    }

    // Rewrite named arguments / fill parameter defaults across all bundled code.
    src_rewritten := rewrite_call_args(rewrite_or_fallbacks(bundled_src));

    raw_c := transpile_source(src_rewritten, false);

    // A file with only `test` blocks has no entry point in a normal build.
    // Say so plainly instead of letting the linker report a missing `main`.
    if !check_only && !str_contains(raw_c, "int main(int argc") {
        println("\x1b[1;31merror\x1b[0m: no 'fn main' found in %", src_path);
        if str_contains(src_content, "test \"") {
            println("  this file declares test blocks; run it with:");
            println("    katlin test %", src_path);
        }
        return 1;
    }

    // Stamp the generated C with a hash of the runtime header plus the exact
    // clang flags. Incremental builds compare the whole file, so a change to
    // std/katlin_runtime.h or a switch between --debug and --release both
    // invalidate the cache even though the user's source is untouched.
    hdr := file_read(str_concat(std_dir, "/katlin_runtime.h"));
    stamp := str_concat("// katlin-runtime-hash: ", str_int(hash(hdr)));

    mut str final_bin = out_binary;
    if str_len(final_bin) == 0 {
        final_bin = str_concat(".build/bin/", base_name);
    }

    // Step 4: Assemble optimisation flags.
    // -march=native is meaningless (and rejected by clang) for a cross target,
    // so it is only added for a native build.
    mut str opt_flags = "-O3 -flto";
    if !optimize {
        opt_flags = "-O0 -g";
    } else if str_len(tool_flags) == 0 {
        opt_flags = str_concat(opt_flags, " -march=native");
    }
    if str_len(tool_flags) > 0 {
        opt_flags = str_concat(opt_flags, tool_flags);
    }

    inc_flags := str_concat(" -I", str_concat(std_dir, " -I. "));

    // Now that the flags are known, assemble the final translation unit.
    // Flags live inside the file so that changing them busts the cache.
    c_code := str_concat(stamp, str_concat("\n// katlin-flags:", str_concat(str_concat(" ", opt_flags), str_concat("\n", raw_c))));

    // Step 5: `check` runs clang's syntax/semantic analysis only.
    if check_only {
        file_write(c_path, c_code);
        cmd := str_concat("clang -fsyntax-only ", str_concat(c_path, inc_flags));
        ret := system(cmd);
        if ret != 0 {
            println("\x1b[1;31merror\x1b[0m: % failed to type-check", src_path);
            return 1;
        }
        println("\x1b[1;32m✓\x1b[0m %: no errors", src_path);
        return 0;
    }

    // Step 6: Incremental build. If the generated C is byte-identical to last
    // time and the binary still exists, clang has nothing to do.
    mut str old_c = "";
    if file_exists(c_path) {
        old_c = file_read(c_path);
    }
    up_to_date := str_eq(old_c, c_code) && file_exists(final_bin);

    if !up_to_date {
        file_write(c_path, c_code);
        tail_flags := str_concat(" -o ", str_concat(final_bin, str_concat(" ", opt_flags)));
        cmd := str_concat("clang ", str_concat(c_path, str_concat(inc_flags, tail_flags)));
        ret := system(cmd);

        if ret != 0 {
            println("\x1b[1;31merror\x1b[0m: native compilation failed (clang exited with code %)", ret);
            if str_len(tool_flags) > 0 {
                println("  hint: cross-compiling needs a target sysroot containing that");
                println("        platform's libc headers. For example:");
                println("          katlin build % --target=aarch64-linux-gnu --sysroot=/usr/aarch64-linux-gnu", src_path);
            }
            return 1;
        }
    }

    if run_after {
        mut str run_cmd = final_bin;
        if str_len(extra_args) > 0 {
            run_cmd = str_concat(final_bin, str_concat(" ", extra_args));
        }
        return system(run_cmd);
    }

    if up_to_date {
        println("\x1b[1;32m✓\x1b[0m Up to date: %", final_bin);
    } else {
        println("\x1b[1;32m✓\x1b[0m Successfully built: %", final_bin);
    }
    return 0;
}

// -------------------------------------------------------------
// File discovery helpers (shared by fmt and test)
// -------------------------------------------------------------

// Write one .ktl path per line into out_file, then return how many there are.
fn list_ktl_files(str path, str out_file) -> int {
    is_dir := system(str_concat("test -d ", path));
    if is_dir == 0 {
        system(str_concat("find ", str_concat(path, str_concat(" -name '*.ktl' -type f > ", out_file))));
    } else {
        file_write(out_file, str_concat(path, "\n"));
    }
    listing := file_read(out_file);
    mut count := 0;
    mut i := 0;
    n := str_len(listing);
    while i < n {
        if str_char_at(listing, i) == 10 { count += 1; }
        i += 1;
    }
    return count;
}

// Return the idx-th (0-based) newline-separated line of listing, or "".
fn listing_line(str listing, int idx) -> str {
    mut i := 0;
    mut line := 0;
    n := str_len(listing);
    while i < n {
        if line == idx {
            ls := i;
            while i < n && str_char_at(listing, i) != 10 { i += 1; }
            return str_sub(listing, ls, i - ls);
        }
        while i < n && str_char_at(listing, i) != 10 { i += 1; }
        if i < n { i += 1; }
        line += 1;
    }
    return "";
}

// -------------------------------------------------------------
// Formatter (katlin fmt) -- conservative and idempotent
// -------------------------------------------------------------

// Strips trailing whitespace, collapses runs of blank lines, and guarantees a
// single trailing newline. Deliberately does NOT reflow operators or touch
// indentation, so it can never alter string literal contents.
fn fmt_one_file(str path) -> int {
    src := file_read(path);
    if str_len(src) == 0 {
        return 0;
    }

    mut out := sb_create(4096);
    n := str_len(src);
    mut i := 0;
    mut blank_run := 0;

    while i < n {
        ls := i;
        while i < n && str_char_at(src, i) != 10 { i += 1; }
        mut le := i;
        while le > ls {
            ch := str_char_at(src, le - 1);
            if ch == 32 || ch == 9 || ch == 13 {
                le -= 1;
            } else {
                break;
            }
        }
        line_len := le - ls;
        if line_len == 0 {
            blank_run += 1;
            if blank_run <= 1 {
                sb_append_char(out, 10);
            }
        } else {
            blank_run = 0;
            sb_append(out, str_sub(src, ls, line_len));
            sb_append_char(out, 10);
        }
        if i < n { i += 1; }
    }

    formatted := sb_build(out);
    if !str_eq(formatted, src) {
        file_write(path, formatted);
        return 1;
    }
    return 0;
}

fn cmd_fmt(str path) -> int {
    if !file_exists(path) {
        println("\x1b[1;31merror\x1b[0m: path not found: %", path);
        return 1;
    }

    list_file := "/tmp/katlin_fmt_files.txt";
    count := list_ktl_files(path, list_file);
    if count == 0 {
        println("\x1b[1;33mnote\x1b[0m: no .ktl files found under %", path);
        return 0;
    }

    listing := file_read(list_file);
    mut rewritten := 0;
    mut i := 0;
    while i < count {
        f := listing_line(listing, i);
        if str_len(f) > 0 && fmt_one_file(f) == 1 {
            rewritten += 1;
            println("  \x1b[1;33mreformatted\x1b[0m %", f);
        }
        i += 1;
    }

    println("\x1b[1;32m✓\x1b[0m Formatted % file(s), % rewritten", count, rewritten);
    return 0;
}

// -------------------------------------------------------------
// Test Runner (katlin test)
// -------------------------------------------------------------

// Compile one file in test mode and execute it.
// Returns 0 = passed, 1 = failed, -1 = file declares no test blocks.
fn run_test_file(str path) -> int {
    src := file_read(path);
    if str_len(src) == 0 {
        return -1;
    }

    mut visited_sb := sb_create(256);
    sb_append(visited_sb, "|");
    sb_append(visited_sb, path);
    sb_append(visited_sb, "|");

    mut err_sb := sb_create(256);
    bundled_src := resolve_imports(path, src, &visited_sb, &err_sb);
    if str_len(sb_build(err_sb)) > 0 {
        println("  \x1b[1;31merror\x1b[0m: %", sb_build(err_sb));
        return 1;
    }

    c_code := transpile_source(rewrite_call_args(rewrite_or_fallbacks(bundled_src)), true);
    if !str_contains(c_code, "ktl_test_0") {
        return -1;
    }

    system("mkdir -p .build/bin");
    base := path_base(path);
    c_path := str_concat(".build/", str_concat(base, "_test.c"));
    bin_path := str_concat(".build/bin/", str_concat(base, "_test"));
    file_write(c_path, c_code);

    std_dir := find_std_dir();
    cmd := str_concat("clang ", str_concat(c_path, str_concat(" -I", str_concat(std_dir, str_concat(" -I. -O1 -o ", bin_path)))));
    if system(cmd) != 0 {
        println("  \x1b[1;31mcompilation failed\x1b[0m");
        return 1;
    }

    println("\n\x1b[1;36m%\x1b[0m", path);
    return system(bin_path);
}

fn cmd_test(str path) -> int {
    if !file_exists(path) {
        println("\x1b[1;31merror\x1b[0m: path not found: %", path);
        return 1;
    }

    list_file := "/tmp/katlin_test_files.txt";
    count := list_ktl_files(path, list_file);
    if count == 0 {
        println("\x1b[1;33mnote\x1b[0m: no .ktl files found under %", path);
        return 0;
    }

    listing := file_read(list_file);
    mut suites := 0;
    mut failed := 0;
    mut i := 0;
    while i < count {
        f := listing_line(listing, i);
        if str_len(f) > 0 {
            r := run_test_file(f);
            if r >= 0 {
                suites += 1;
                if r != 0 { failed += 1; }
            }
        }
        i += 1;
    }

    println("");
    if suites == 0 {
        println("\x1b[1;33mnote\x1b[0m: no test blocks found under %", path);
        return 0;
    }
    if failed == 0 {
        println("\x1b[1;32m✓\x1b[0m % test suite(s) passed", suites);
        return 0;
    }
    println("\x1b[1;31m✗\x1b[0m % of % test suite(s) failed", failed, suites);
    return 1;
}

// -------------------------------------------------------------
// Main CLI Driver
// -------------------------------------------------------------

fn main {
    total := args_count();
    if total < 2 {
        print_help();
        exit(0);
    }

    cmd := args_get(1);

    if str_eq(cmd, "version") || str_eq(cmd, "--version") || str_eq(cmd, "-v") {
        print_version();
        exit(0);
    }

    if str_eq(cmd, "help") || str_eq(cmd, "--help") || str_eq(cmd, "-h") {
        print_help();
        exit(0);
    }

    if str_eq(cmd, "init") {
        mut str proj_name = "";
        if total >= 3 { proj_name = args_get(2); }
        exit(cmd_init(proj_name));
    }

    if str_eq(cmd, "fmt") {
        mut str fmt_path = ".";
        if total >= 3 { fmt_path = args_get(2); }
        exit(cmd_fmt(fmt_path));
    }

    if str_eq(cmd, "test") {
        mut str test_path = ".";
        if total >= 3 { test_path = args_get(2); }
        exit(cmd_test(test_path));
    }

    if str_eq(cmd, "run") {
        if total < 3 {
            println("\x1b[1;31merror\x1b[0m: no input file specified for 'run'");
            exit(1);
        }
        src_file := args_get(2);
        mut str extra = "";
        for i in 3..total {
            extra = str_concat(extra, str_concat(args_get(i), " "));
        }
        exit(compile_file(src_file, "", true, true, extra, "", false));
    }

    // Type-check only: no binary, no linking. Useful in editors and CI.
    if str_eq(cmd, "check") {
        if total < 3 {
            println("\x1b[1;31merror\x1b[0m: no input file specified for 'check'");
            exit(1);
        }
        exit(compile_file(args_get(2), "", true, false, "", "", true));
    }

    if str_eq(cmd, "build") {
        if total < 3 {
            println("\x1b[1;31merror\x1b[0m: no input file specified for 'build'");
            exit(1);
        }
        src_file := args_get(2);
        mut str out_bin = "";
        mut optimize := true;
        mut str target = "";
        mut str sysroot = "";
        mut explicit_opt := false;

        mut i := 3;
        while i < total {
            arg := args_get(i);
            if str_eq(arg, "-o") && i + 1 < total {
                out_bin = args_get(i + 1);
                i += 2;
            } else if str_eq(arg, "--target") && i + 1 < total {
                target = args_get(i + 1);
                i += 2;
            } else if str_starts_with(arg, "--target=") {
                target = str_sub(arg, 9, str_len(arg) - 9);
                i += 1;
            } else if str_eq(arg, "--sysroot") && i + 1 < total {
                sysroot = args_get(i + 1);
                i += 2;
            } else if str_starts_with(arg, "--sysroot=") {
                sysroot = str_sub(arg, 10, str_len(arg) - 10);
                i += 1;
            } else if str_eq(arg, "--debug") {
                optimize = false;
                explicit_opt = true;
                i += 1;
            } else if str_eq(arg, "--release") {
                optimize = true;
                explicit_opt = true;
                i += 1;
            } else {
                i += 1;
            }
        }

        // Honour katlin.toml only when the command line did not decide.
        // `opt_level = 0` means debug, anything higher means optimised.
        if !explicit_opt {
            level := toml_opt_level();
            if level == 0 {
                optimize = false;
            }
        }

        // Assemble cross-compilation flags. Kept as one string so the
        // "is this a cross build?" question is a simple emptiness check.
        mut str tool_flags = "";
        if str_len(target) > 0 {
            tool_flags = str_concat(" --target=", target);
        }
        if str_len(sysroot) > 0 {
            tool_flags = str_concat(tool_flags, str_concat(" --sysroot=", sysroot));
        }

        exit(compile_file(src_file, out_bin, optimize, false, "", tool_flags, false));
    }

    // Fallback: if user specified 'katlin file.ktl', default to run
    if file_exists(cmd) {
        exit(compile_file(cmd, "", true, true, "", "", false));
    }

    println("\x1b[1;31merror\x1b[0m: unknown command '%'", cmd);
    print_help();
    exit(1);
}
