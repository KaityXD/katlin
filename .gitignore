# Build output
.build/
*.o
*.a

# Python
__pycache__/
src/__pycache__/
tests/__pycache__/
*.pyc

# Editors / OS
.idea/
.DS_Store
*.swp

# VS Code extension dependencies (npm install in editors/vscode/).
# The language server itself has no dependencies and is committed.
node_modules/
*.vsix

# Generated by editors/zed/setup.sh -- it embeds an absolute path to the
# bundled tree-sitter grammar, so it is machine-specific by design.
editors/zed/extension.toml
editors/zed/target/
grammars/tree-sitter-katlin/target/

# NOTE: bin/katlin is intentionally committed. It is the bootstrapped native
# compiler, so `git clone && ./bin/katlin run examples/tour.ktl` works with no
# Python or build step. Regenerate it with ./build.sh after editing
# compiler/main.ktl.
