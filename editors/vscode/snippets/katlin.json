{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:void} {",
      "    $0",
      "}"
    ],
    "description": "Define a Katlin function"
  },
  "Parameterless Function": {
    "prefix": "fnp",
    "body": [
      "fn ${1:name} {",
      "    $0",
      "}"
    ],
    "description": "Define a parameterless Katlin function"
  },
  "Range For Loop with Step": {
    "prefix": "forstep",
    "body": [
      "for ${1:i} in ${2:0}..${3:100} step ${4:10} {",
      "    $0",
      "}"
    ],
    "description": "Range for loop with step"
  },
  "Range For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "    $0",
      "}"
    ],
    "description": "Standard range for loop"
  },
  "Test Block": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "    assert(${2:condition}, \"${3:failure message}\");$0",
      "}"
    ],
    "description": "Katlin unit test block"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:int} ${3:field};$0",
      "}"
    ],
    "description": "Define a Katlin struct"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:first},",
      "    ${3:second}$0",
      "}"
    ],
    "description": "Define a Katlin enum"
  },
  "Println": {
    "prefix": "pl",
    "body": [
      "println(\"${1:Value: %}\", ${2:val});$0"
    ],
    "description": "Print line with positional slot %"
  }
}
