{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Katlin",
  "scopeName": "source.katlin",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragmas" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.katlin",
          "match": "//.*$"
        },
        {
          "name": "comment.block.katlin",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "pragmas": {
      "patterns": [
        {
          "name": "keyword.control.directive.katlin",
          "match": "^\\s*#strict\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.katlin",
          "match": "\\b(if|elif|else|while|loop|for|in|step|return|match|case|or)\\b"
        },
        {
          "name": "storage.type.function.katlin",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "storage.modifier.katlin",
          "match": "\\b(mut|strict|raw)\\b"
        },
        {
          "name": "keyword.declaration.katlin",
          "match": "\\b(struct|enum|test)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.katlin",
          "match": "\\b(int|i64|u64|str|bool|float|f64|byte|void|vec|arena)\\b"
        },
        {
          "name": "entity.name.type.custom.katlin",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.katlin",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.katlin",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.katlin",
              "match": "\\\\([ntr\"\\\\])"
            },
            {
              "name": "constant.other.placeholder.katlin",
              "match": "%"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.katlin",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.katlin",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.katlin",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.katlin",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.katlin",
          "match": "\\b(println|print|panic|assert|time_now|get_ram_mb|alloc_ints|free_ints|arena_create|arena_alloc|arena_reset|arena_destroy|vec_create|vec_push|vec_get|vec_set|vec_len|vec_free|file_read|file_write|file_append|file_exists|str_len|str_eq|str_concat|abs|min|max)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.katlin" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.katlin" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.define.katlin",
          "match": ":="
        },
        {
          "name": "keyword.operator.range.katlin",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.katlin",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.katlin",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.katlin",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.katlin",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.reference.katlin",
          "match": "&"
        }
      ]
    }
  }
}
