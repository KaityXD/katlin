{
  "name": "katlin-lang",
  "displayName": "Katlin Programming Language",
  "description": "Language support for the Katlin programming language (.ktl): live diagnostics from the compiler, plus syntax highlighting and snippets.",
  "version": "0.2.0",
  "publisher": "katlin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:katlin"
  ],
  "scripts": {
    "test": "node server/test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "configuration": {
      "title": "Katlin",
      "properties": {
        "katlin.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the katlin binary. Leave empty to use bin/katlin from the workspace, then katlin on $PATH."
        }
      }
    },
    "languages": [
      {
        "id": "katlin",
        "aliases": ["Katlin", "ktl"],
        "extensions": [".ktl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "katlin",
        "scopeName": "source.katlin",
        "path": "./syntaxes/katlin.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "katlin",
        "path": "./snippets/katlin.json"
      }
    ]
  }
}
