// examples/http_server.ktl
// A production-fast HTTP Web Server written completely in Katlin!
//
// Run this with:
//   ./bin/katlin run examples/http_server.ktl
//
// Then in another terminal, test it with:
//   curl http://localhost:8080/
//   curl http://localhost:8080/api/status
//   curl http://localhost:8080/api/echo?msg=KatlinRocks

fn handle_client(int client_fd) {
    req := net_tcp_read(client_fd, 2048);
    if str_len(req) == 0 {
        net_close(client_fd);
        return;
    }

    first_line := str_split_at(req, "\r\n", 0);
    method := str_split_at(first_line, " ", 0);
    path := str_split_at(first_line, " ", 1);

    println("--> Incoming Request: % %", method, path);

    mut str body = "";
    mut str status = "200 OK";
    mut str content_type = "application/json";

    if str_eq(path, "/") {
        content_type = "text/html; charset=utf-8";
        body = "<html><body><h1>Hello from Katlin Native HTTP Server!</h1><p>Running with zero garbage collection and native C99 speed.</p><ul><li><a href='/api/status'>/api/status</a></li><li><a href='/api/time'>/api/time</a></li></ul></body></html>";
    } else if str_eq(path, "/api/status") {
        body = "{\"status\": \"operational\", \"server\": \"katlin-v0.1.0\", \"uptime_sec\": 120}";
    } else if str_eq(path, "/api/time") {
        now := time_unix();
        body = str_concat("{\"epoch_timestamp\": ", str_concat(str_int(now), "}"));
    } else {
        status = "404 Not Found";
        body = "{\"error\": \"route not found\", \"code\": 404}";
    }

    resp_len := str_len(body);
    mut resp := sb_create(str_len(body) + 256);
    sb_append(resp, str_concat("HTTP/1.1 ", str_concat(status, "\r\n")));
    sb_append(resp, str_concat("Content-Type: ", str_concat(content_type, "\r\n")));
    sb_append(resp, str_concat("Content-Length: ", str_concat(str_int(resp_len), "\r\n")));
    sb_append(resp, "Server: Katlin/0.1.0\r\n");
    sb_append(resp, "Connection: close\r\n\r\n");
    sb_append(resp, body);

    net_tcp_write(client_fd, sb_build(resp));
    sb_free(resp);
    net_close(client_fd);
}

fn main {
    port := 8080;
    server := net_tcp_listen(port);
    if server < 0 {
        println("Failed to bind server on port %", port);
        return;
    }

    println("🚀 Katlin HTTP Server started!");
    println("   Listening on http://localhost:%", port);
    println("   Press Ctrl+C to stop.\n");

    mut request_count := 0;
    while true {
        client := net_tcp_accept(server);
        if client >= 0 {
            handle_client(client);
            request_count += 1;
        }
    }

    net_close(server);
}
